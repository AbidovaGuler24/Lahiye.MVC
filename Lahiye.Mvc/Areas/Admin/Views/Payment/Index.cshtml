@{
    ViewData["Title"] = "Kitab Ödənişi";
}

<h2 class="mb-4">📘 Pullu Kitab Ödənişi</h2>

<form asp-action="Checkout" method="post">
    <div class="form-group mb-3">
        <label for="amount">Ödəniş məbləği (₼)</label>
        <input type="number" name="amount" class="form-control" min="0.1" step="0.01" required />
    </div>

    <button type="submit" class="btn btn-primary">💳 Ödəniş et</button>
</form>
