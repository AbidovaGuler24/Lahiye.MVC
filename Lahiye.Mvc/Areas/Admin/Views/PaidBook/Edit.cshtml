@using OnlineLearning.Core.Entities
@model OnlineLearning.Core.ViewModels.PaidBookUpdateVm
@{
    ViewData["Title"] = "Kitabı Yenilə";
}

<h2 class="text-2xl font-bold mb-4">✏️ Kitabı Yenilə</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />

    <div class="form-group mb-2">
        <label>Başlıq</label>
        <input asp-for="Title" class="form-control" required />
    </div>

    <div class="form-group mb-2">
        <label>Açıqlama</label>
        <textarea asp-for="Description" class="form-control" required></textarea>
    </div>

    <div class="form-group mb-2">
        <label>Səhifə sayı</label>
        <input asp-for="PageCount" class="form-control" type="number" required />
    </div>

    <div class="form-group mb-2">
        <label>Qiymət (₼)</label>
        <input asp-for="Price" class="form-control" type="number" step="0.01" required />
    </div>
   
        <select asp-for="CategoryId" class="form-select" aria-label="Default select example">
            <option selected>Open this select menu</option>
            @{
                foreach (var item in ViewBag.Categories as List<Category>)
                {
                    <option value=@item.Id>@item.Name</option>
                }
            }


        </select>
   
    <div class="form-group mb-2">
        <label hidden></label>
        <input hidden asp-for="Img" class="form-control" type="number" step="0.01" />
    </div>
    <div class="form-group mb-2">
        <label>Hazırkı Şəkil</label><br />
        <img src="~/Imagess/@Model.Img" width="100" />
    </div>

    <div class="form-group mb-2">
        <label>Yeni Şəkil (əgər dəyişmək istəsəniz)</label>
        <input asp-for="ImgFile" class="form-control" type="file" accept="image/*" />
    </div>

    <div class="form-group mb-2">
        <label>Hazırkı PDF</label><br />
        <a href="~/Files/@Model.Pdf" target="_blank">PDF-ə bax</a>
    </div>

    <div class="form-group mb-3">
        <label>Yeni PDF (əgər dəyişmək istəsəniz)</label>
        <input asp-for="PdfFile" class="form-control" type="file" accept=".pdf" />
    </div>

    <button asp-action="Edit" type="submit" class="btn btn-primary">Yadda saxla</button>
    <a asp-action="Index" class="btn btn-secondary">Geri</a>
</form>
@section Scripts {
}