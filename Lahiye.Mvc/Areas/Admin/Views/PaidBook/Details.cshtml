@model OnlineLearning.Core.ViewModels.PaidBookVm
@{
    ViewData["Title"] = "Kitab Detalları";
}

<h2 class="text-2xl font-bold mb-4">📘 @Model.Title</h2>

<div class="row">
    <div class="col-md-4">
        <img src="~/Imagess/@Model.Img" class="img-fluid" />
    </div>
    <div class="col-md-8">
        <p><strong>Açıqlama:</strong> @Model.Description</p>
        <p><strong>Səhifə sayı:</strong> @Model.PageCount</p>
        <p><strong>Qiymət:</strong> @Model.Price ₼</p>
        <p>
            <strong>PDF:</strong>
            <a href="~/Files/@Model.Pdf" target="_blank">PDF-ə bax</a>
        </p>

        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Yenilə</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Sil</a>
        <a asp-action="Index" class="btn btn-secondary">Geri</a>
    </div>
</div>
@section Scripts {}