@model List<OnlineLearning.Core.ViewModels.PaidBookVm>
@{
    ViewData["Title"] = "Paid Book List";
}

<h2 class="text-2xl font-bold mb-4">📚 Paid Books </h2>
<div class="mt-4">
    <a asp-action="Create" class="btn btn-primary">➕ Create New Book</a>
</div>
<table class="table table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Img</th>
            <th>Pdf</th>
            <th>Title</th>
            <th>PageCount</th>
            <th>Price</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td>
                    <img src="~/Imagess/@book.Img" width="70" />
                </td>
                <td><a href="~/Files/@book.Pdf" target="_blank">View PDF</a></td>
                
                <td>@book.Title</td>
                <td>@book.PageCount</td>
                <td>@book.Price.ToString("0.00") ₼</td>
                <td>
                    <a asp-action="Details" asp-route-id="@book.Id" class="btn btn-info btn-sm">Detallar</a>
                    <a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-warning btn-sm">Yenilə</a>
                    <form asp-action="Delete" asp-route-id="@book.Id" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-danger btn-sm">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>



@section Scripts {
}