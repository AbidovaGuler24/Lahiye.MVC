@using OnlineLearning.Core.Entities
@model OnlineLearning.Core.ViewModels.PaidBookCreateVm
@{
    ViewData["Title"] = "Yeni Pullu Kitab Əlavə Et";
}

<h2 class="text-xl font-semibold mb-4">➕ Yeni Pullu Kitab Əlavə Et</h2>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div class="form-group mb-2">
        <label>Title</label>
        <input asp-for="Title" class="form-control" required />
    </div>

    <div class="form-group mb-2">
        <label>Description</label>
        <textarea asp-for="Description" class="form-control" required></textarea>
    </div>

    <div class="form-group mb-2">
        <label>Page Count</label>
        <input asp-for="PageCount" class="form-control" type="number" min="1" required />
    </div>

    <div class="form-group mb-2">
        <label>Price (₼)</label>
        <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" required />
    </div>
    <select asp-for="CategoryId" class="form-select" aria-label="Default select example">
        <option selected>Open this select menu</option>
        @{
            foreach (var item in ViewBag.Categories as List<Category>)
            {
                <option value=@item.Id>@item.Name</option>
            }
        }


    </select>
    <div class="form-group mb-2">
        <label>Image (JPG/PNG)</label>
        <input asp-for="ImgFile" class="form-control" type="file" accept="image/*" required />
    </div>

    <div class="form-group mb-3">
        <label>PDF </label>
        <input asp-for="PdfFile" class="form-control" type="file" accept=".pdf" required />
    </div>

    <button type="submit" class="btn btn-success">Əlavə et</button>
    <a asp-action="Index" class="btn btn-secondary ml-2">Geri qayıt</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
