@model List<OnlineLearning.Core.ViewModels.NewsEventVm>

@{
    ViewData["Title"] = "News & Events";
}

<h2>News & Events</h2>

<p>
    <a asp-action="Create" class="btn btn-success">Create New</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Description</th>
            <th>Date</th>
            <th>Image</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
                <tr>
                    <td>@item.Title</td>
                    <td>@item.Description</td>
                    <td>@item.Date.ToString("yyyy-MM-dd")</td>
                    <td>
                    @if (!string.IsNullOrEmpty(item.ImagePath))
                    {
                        <img src="~/imagess/@item.ImagePath" alt="Image" style="max-width: 100px; max
        -height: 70px;" />
                    }
                    else
                    {
                                <span>No Image</span>
                    }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Details</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Edit</a>
                    <form asp-area="Admin" asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline-block;">
                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this author?');">Delete</button>
                    </form>
                    </td>
                </tr>
        }
    </tbody>
</table>
@section Scripts {

}