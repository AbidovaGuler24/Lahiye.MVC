@model OnlineLearning.Core.ViewModels.NewsEventVm

@{
    ViewData["Title"] = "News/Event Details";
}

<h2>News/Event Details</h2>

<div>
    <h4>@Model.Title</h4>
    <p><strong>Date:</strong> @Model.Date.ToString("yyyy-MM-dd")</p>
    <p><strong>Description:</strong></p>
    <p>@Model.Description</p>

    @if (!string.IsNullOrEmpty(Model.ImagePath))
    {
        <img src="~/Imagess/@Model.ImagePath" alt="Image" style="max-width: 500px; max-height: 400px;" />
    }
    else
    {
        <p>No image available.</p>
    }
</div>

<p>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</p>
@section Scripts {

}