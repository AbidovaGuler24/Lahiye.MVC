@model OnlineLearning.Core.ViewModels.EmployeeAddVm

@{
    ViewData["Title"] = "Add New Employee";
}

<h2>Add New Employee</h2>

<form asp-action="Create" enctype="multipart/form-data">
    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger" />
    </div>

    <div class="form-group">
        <label asp-for="Position"></label>
        <input asp-for="Position" class="form-control" />
        <span asp-validation-for="Position" class="text-danger" />
    </div>

    <div class="form-group">
        <label asp-for="PhotoFile">Photo</label>
        <input asp-for="PhotoFile" type="file" class="form-control" />
        <span asp-validation-for="PhotoFile" class="text-danger" />
    </div>

    <button type="submit" class="btn btn-success">Create</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
@section Scripts { }