@model List<OnlineLearning.Core.ViewModels.EmployeeVM>
@{
    ViewData["Title"] = "Employee List";
}

<h2 class="mb-4">@ViewData["Title"]</h2>
<a asp-area="Admin" asp-action="PendingList" class="btn btn-warning mb-3 me-2">Pending Employees (Yeni CV-lər)</a>
@* 
<a asp-action="Create" class="btn btn-primary mb-3">Add New Employee</a>
 *@
<table class="table table-bordered table-striped">
    <thead class="thead-dark">
        <tr>
            <th>Name</th>      
            <th>Position</th>  
            <th>Photo</th>
            <th style="width: 180px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var employee in Model)
        {
            <tr>
                <td>@employee.FullName</td>
                <td>@employee.Position</td>
                <td>
                    @if (!string.IsNullOrEmpty(employee.PhotoPath))
                    {
                        <img src="~/imagess/@employee.PhotoPath" alt="@employee.FullName" width="80" class="img-thumbnail" />
                    }
                    else
                    {
                        <span>No Photo</span>
                    }
                </td>
              
                    <td>

                        <a asp-area="Admin" asp-action="Details" asp-route-id="@employee.Id" class="btn btn-info btn-sm">View</a>
                        <a asp-area="Admin" asp-action="Edit" asp-route-id="@employee.Id" class="btn btn-warning btn-sm">Edit</a>
                        <form asp-area="Admin" asp-action="DeleteConfirmed" asp-route-id="@employee.Id" method="post" style="display:inline-block;">
                            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this employee ?');">Delete</button>
                        </form>
                    </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        console.log("Employee Index page loaded.");
    </script>
}
