@model IEnumerable<OnlineLearning.Core.ViewModels.LibraryItemVM>

@{
    ViewData["Title"] = "Kitablar Siyahısı";
}
<form method="get" asp-action="Index" class="mb-4">
    <input type="text" name="searchTerm" value="@Context.Request.Query["searchTerm"]" placeholder="Axtar..." class="form-control" />
</form>
<h2>@ViewData["Title"]</h2>

<a asp-action="Create" class="btn btn-success mb-3">Yeni Kitab Əlavə Et</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Başlıq</th>
            <th>Müəllif</th>
            <th>Yaş Kateqoriyası</th>
            <th>Audio</th>
            <th>Şəkil</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Author</td>
                <td>@item.AgeCategory</td>
                <td>
                    @if (!string.IsNullOrEmpty(item.ExistingAudioPath))
                    {
                        <audio controls>
                            <source src="~/audio/@item.ExistingAudioPath" type="audio/mpeg" />
                            Sizin brauzer audio elementini dəstəkləmir.
                        </audio>
                    }
                </td>
                <td>
                    
                    @if (!string.IsNullOrEmpty(item.ExistingImagePath))
                    {
                        <img src="~/imagess/@item.ExistingImagePath" alt="@item.Title" style="max-height: 80px;" />
                    }
                </td>
                <td>
                   
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Düzəliş et</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}