@model IEnumerable<OnlineLearning.Core.Entities.Moment>

@{
    ViewData["Title"] = "Moments List";
}

<h2>Moments List</h2>

<p>
    <a asp-action="Create" class="btn btn-success">Create New Moment</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Description</th>
            <th>Image</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var moment in Model)
        {
            <tr>
                <td>@moment.Title</td>
                <td>@moment.Description</td>
                <td>
                    @if (!string.IsNullOrEmpty(moment.ImagePath))
                    {
                        <img src="~/imagess/@moment.ImagePath" alt="Alternate Text" style="width:100px; height:auto;" />
                    }
                    else
                    {
                        <span>No image</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@moment.Id" class="btn btn-primary btn-sm">Edit</a>
                    <form asp-action="Delete" asp-route-id="@moment.Id" method="post" style="display:inline" onsubmit="return confirm('Are you sure you want to delete this moment?');">
                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    </form>
                </td>
            </tr>
            <tr>
                <td colspan="4">
                    <strong>Comments:</strong>
                    @if (moment.Comments != null && moment.Comments.Any())
                    {
                        <table class="table table-sm table-bordered mt-2">
                            <thead>
                                <tr>
                                    <th>User</th>
                                    <th>Content</th>
                                    <th>Created At</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var comment in moment.Comments)
                                {
                                    <tr>
                                        <td>@comment.UserName</td>
                                        <td>@comment.Content</td>
                                        <td>@comment.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                        <td>
                                            <form asp-action="DeleteComment" asp-route-id="@comment.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this comment?');">
                                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p>No comments yet.</p>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
