@model List<OnlineLearning.Core.ViewModels.BookVm>
@{
    ViewData["Title"] = "Book List";
}
<p>
    <a asp-action="Create" class="btn btn-primary">Add Create</a>
</p>
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>📚 Book List</h2>
    </div>

    <table class="table table-hover table-striped align-middle shadow-sm border">
        <thead class="table-dark">
            <tr>
                <th>Title</th>
                <th>Description</th>
                <th>Page Count</th>
                <th>Image</th>
                <td>Category</td>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model)
            {
                <tr>
                    <td>@book.Title</td>
                    <td>@book.Description</td>
                    <td>@book.PageCount</td>
                    <td>@book.Category</td>
                    <td>
                        @if (!string.IsNullOrEmpty(book.Img))
                        {
                            <img src="~/Imagess/@book.Img" class="img-thumbnail" style="width: 80px;" />
                        }
                    </td>
                   @*  <td>
                        @if (!string.IsNullOrEmpty(book.Pdf))
                        {
                            <button class="btn btn-outline-primary btn-sm" onclick="showAdThenDownload('/Files/@book.Pdf')">
                                <i class="bi bi-file-earmark-arrow-down"></i> PDF-ni Yüklə
                            </button>
                        }
                        else
                        {
                            <span class="text-muted"><em>No PDF</em></span>
                        }
                    </td> *@
                    <td class="text-center">
                        <div class="btn-group">
                            <a class="btn btn-info" asp-action="Details" asp-route-id="@book.Id">Details</a>
                            <a class="btn btn-dark" asp-action="Edit" asp-route-id="@book.Id">Edit</a>
                            <form asp-action="Delete" asp-route-id="@book.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this book?');" style="display:inline;">
                                <button type="submit" class="btn btn-danger">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

