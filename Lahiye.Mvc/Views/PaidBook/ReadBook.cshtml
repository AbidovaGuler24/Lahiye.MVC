@using OnlineLearning.Core.ViewModels
@model PaidBookVm
@{
    Layout = "";
}

<style>
    .pdf-reader-container {
        width: 100%;
        max-width: 900px;
        height: 700px;
        margin: 40px auto;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        border-radius: 10px;
        overflow: hidden;
        border: 2px solid #4a90e2;
        transition: box-shadow 0.3s ease;
    }

        .pdf-reader-container:hover {
            box-shadow: 0 6px 20px rgba(0,0,0,0.3);
        }

        .pdf-reader-container iframe {
            width: 100%;
            height: 100%;
            border: none;
        }

    .action-button {
        display: block;
        margin: 25px auto;
        padding: 14px 35px;
        background-color: #4a90e2;
        color: white;
        font-size: 16px;
        border: none;
        border-radius: 25px;
        cursor: pointer;
        text-decoration: none;
        text-align: center;
        width: fit-content;
    }

        .action-button:hover {
            background-color: #357ab8;
        }

</style>

<div class="pdf-reader-container">
    <iframe src="@(
        Model.IsPaid
        ? Url.Content($"~/Files/{Model.Pdf}")
        : Url.Action("GetFirst10Pages", "PaidBook", new { pdfFileName = Model.Pdf })
    )" width="100%" height="100%"></iframe>
</div>

@if (!Model.IsPaid)
{
    <a class="action-button" href="@Url.Action("CreateCheckoutSession", "Checkout", new { bookId = Model.Id })">
        🔒 Tam oxumaq üçün satın al
    </a>
}
