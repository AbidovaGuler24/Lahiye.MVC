@model IEnumerable<OnlineLearning.Core.ViewModels.PaidBookVm>

@{
    Layout = null;
    ViewData["Title"] = "Pullu Kitablar";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    body {
        background-color: #f5f1ea; /* krem arxa fon */
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .book-card {
        width: 180px; /* kart ölçüsünü kiçildirik ki 6 yan-yana rahat sığsın */
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 3px 8px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        padding: 12px 12px 16px;
        text-align: center;
        margin: 15px auto;
        position: relative;
        transition: box-shadow 0.3s ease;
    }

        .book-card:hover {
            box-shadow: 0 6px 18px rgba(0, 0, 0, 0.15);
        }

    .book-image {
        width: 100%;
        height: 240px;
        object-fit: cover;
        border-radius: 10px;
        cursor: pointer;
        transition: transform 0.25s ease;
    }

        .book-image:hover {
            transform: scale(1.05);
        }

    .no-image {
        width: 100%;
        height: 240px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eae6dd;
        color: #999;
        border-radius: 10px;
        font-style: italic;
    }

    .book-meta {
        font-weight: 600;
        font-size: 14px;
        margin-top: 10px;
        color: #555;
    }

    .book-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        margin-top: 14px;
    }

        .book-actions button,
        .book-actions a.btn {
            width: 36px;
            height: 36px;
            font-size: 18px;
            padding: 0;
            border-radius: 50%;
            border: 2px solid transparent;
            background: transparent;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
            color: #666;
        }

            .book-actions button:hover,
            .book-actions a.btn:hover {
                color: #444;
                transform: scale(1.2);
                text-decoration: none;
            }

    .btn-outline-danger:hover {
        background-color: #c94e4e;
        border-color: #c94e4e;
    }

    .btn-outline-primary:hover {
        background-color: #4a86e8;
        border-color: #4a86e8;
    }

    .btn-outline-secondary:hover {
        background-color: #8a8a8a;
        border-color: #8a8a8a;
    }

    .btn-success {
        width: 36px;
        height: 36px;
        font-size: 18px;
        padding: 0;
        border-radius: 50%;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #8f7a56;
        color: white;
        transition: background-color 0.3s ease;
    }

        .btn-success:hover {
            background-color: #a5946e;
        }

    .favorite-icon {
        position: absolute;
        top: 10px;
        right: 10px;
        background: rgba(255, 255, 255, 0.85);
        border-radius: 50%;
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
        border: 1.5px solid #b07a5a;
        cursor: pointer;
        transition: background-color 0.3s ease, transform 0.3s ease;
        color: #b07a5a;
        font-size: 20px;
        z-index: 10;
    }

        .favorite-icon:hover,
        .favorite-icon:focus {
            background-color: #b07a5a;
            color: white;
            transform: scale(1.3);
            outline: none;
        }

    .section-title {
        color: #6b5e44;
        margin-bottom: 1.5rem;
    }

        .section-title h2 {
            font-weight: 600;
            font-size: 1.8rem;
        }

    .underline {
        width: 80px;
        height: 3px;
        background-color: #b07a5a;
        margin: 8px auto 16px auto;
        border-radius: 2px;
    }

    .subtitle {
        font-size: 1rem;
        color: #7d7561;
    }
</style>

<div class="section-title text-center">
    <h2><span>📚</span> Premium Kitab Kataloqu</h2>
    <div class="underline"></div>
    <p class="subtitle">Ən keyfiyyətli kitabları sizin üçün seçdik</p>
</div>

<div class="container">
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-6 g-4 justify-content-center">
        @foreach (var book in Model)
        {
            <div class="col d-flex justify-content-center">
                <div class="book-card">
                    <form asp-action="AddToFavorites" asp-controller="Favorites" method="post" style="position:absolute; top:0; right:0; margin:8px;">
                        <input type="hidden" name="bookId" value="@book.Id" />
                        <button type="submit" class="favorite-icon" title="Sevimli">
                            ❤️
                        </button>
                    </form>

                    @if (!string.IsNullOrEmpty(book.Img))
                    {
                        <a asp-controller="PaidBook" asp-action="Details" asp-route-id="@book.Id" title="@book.Title">
                            <img src="~/Imagess/@book.Img" class="book-image" alt="@book.Title" />
                        </a>
                    }
                    else
                    {
                        <div class="no-image">Şəkil yoxdur</div>
                    }

                    <div class="book-body">
                        <div class="book-meta">Qiymət: @book.Price ₼</div>
                    </div>

                    <div class="book-actions">
                        <form asp-action="AddToCart" asp-controller="PaidBook" method="post" style="display:inline;">
                            <input type="hidden" name="bookId" value="@book.Id" />
                            <button type="submit" class="btn btn-outline-primary" title="Səbətə">
                                🛒
                            </button>
                        </form>

                        <form asp-action="ReadBook" asp-controller="PaidBook" method="post" style="display:inline;">
                            <input type="hidden" name="bookId" value="@book.Id" />
                            <button asp-route-id="@book.Id" asp-action="ReadBook" type="submit" class="btn btn-outline-secondary" title="Oxu">
                                📖
                            </button>
                        </form>

                        <form asp-action="Checkout" asp-controller="Payment" method="post" style="display:inline;">
                            <input type="hidden" name="bookId" value="@book.Id" />
                            <input type="hidden" name="amount" value="@book.Price" />
                            <a asp-controller="Checkout" asp-action="CreateCheckoutSession" asp-route-bookId="@book.Id" class="btn btn-success text-white" title="Al">
                                💳
                            </a>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
}
