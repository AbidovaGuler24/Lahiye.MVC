@model IEnumerable<OnlineLearning.Core.ViewModels.PaidBookVm>

@{
    ViewData["Title"] = "Pullu Kitablar";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<h2 class="mb-4">📚 Kitab Kataloqu</h2>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var book in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                @if (!string.IsNullOrEmpty(book.Img))
                {
                    <img src="~/Imagess/@book.Img" class="card-img-top" alt="@book.Title" style="object-fit:cover; height:200px;">
                }
                else
                {
                    <div class="bg-light d-flex justify-content-center align-items-center" style="height:200px;">
                        <span class="text-muted">No Image</span>
                    </div>
                }

                <div class="card-body">
                    <h5 class="card-title">@book.Title</h5>
                    <p class="card-text text-truncate">@book.Description</p>
                    <p><small>Səhifə sayı: @book.PageCount</small></p>
                    <p><strong>Qiymət:</strong> @book.Price ₼</p>
                </div>

                <div class="card-footer d-flex justify-content-between align-items-center">

                    <form asp-action="AddToFavorites" asp-controller="PaidBook" method="post" style="display:inline-block;">
                        <input type="hidden" name="bookId" value="@book.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Sevimlilərə əlavə et">
                            ❤️
                        </button>
                    </form>

                    <form asp-action="AddToCart" asp-controller="PaidBook" method="post" style="display:inline-block; margin-left:5px;">
                        <input type="hidden" name="bookId" value="@book.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-primary" title="Səbətə əlavə et">
                            🛒
                        </button>
                    </form>
                    <form asp-action="AddToFavoritesAndCart" asp-controller="PaidBook" method="post">
                       
                        <button asp-route-id="@book.Id" asp-action="ReadBook" type="submit" class="btn btn-sm btn-outline-primary">
                            Read Book
                        </button>
                    </form>
                    <form asp-action="Checkout" asp-controller="Payment" method="post">
                        <input type="hidden" name="bookId" value="@book.Id" />
                        <input type="hidden" name="amount" value="@book.Price" />
                        <a asp-controller="Checkout" asp-action="CreateCheckoutSession" asp-route-bookId="@book.Id" class="btn btn-sm btn-success">
                            💳 Alış-veriş
                        </a>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
}
