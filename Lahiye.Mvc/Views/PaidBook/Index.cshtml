@model IEnumerable<OnlineLearning.Core.ViewModels.PaidBookVm>

@{
    Layout ="_Layout1";
    ViewData["Title"] = "Premium Kitablar";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["InfoMessage"] != null)
{
    <div class="alert alert-info alert-dismissible fade show m-3" role="alert">
        @TempData["InfoMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<style>
    body {
        background: linear-gradient(to bottom right, #f6f1e7, #e8d8c3);
        font-family: 'Playfair Display', serif;
        color: #3c2f24;
    }

    .section-title {
        color: #3c2f24;
        text-align: center;
        margin-bottom: 2rem;
        text-shadow: 1px 1px 2px rgba(0,0,0,0.1);
    }

    .underline {
        width: 80px;
        height: 4px;
        background: linear-gradient(90deg, #d4af37, #c29e2f);
        margin: 8px auto 16px;
        border-radius: 2px;
    }

    .book-card {
        background: rgba(255, 255, 255, 0.6);
        backdrop-filter: blur(12px);
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
        transition: transform 0.4s ease, box-shadow 0.4s ease;
        overflow: hidden;
        text-align: center;
        max-width: 230px;
        margin: 20px auto;
        padding: 18px;
        position: relative; /* mütləq */
    }

        .book-card:hover {
            transform: scale(1.05) rotate(-1deg);
            box-shadow: 0 16px 32px rgba(0,0,0,0.25);
        }

    .book-image {
        width: 100%;
        height: 260px;
        object-fit: cover;
        border-radius: 15px;
        transition: transform 0.3s ease;
    }

        .book-image:hover {
            transform: scale(1.08);
        }

    .no-image {
        width: 100%;
        height: 260px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e6d5ba;
        color: #7b5e3d;
        border-radius: 15px;
        font-style: italic;
    }

    .book-meta {
        font-weight: 700;
        font-size: 16px;
        margin-top: 15px;
        color: #4a3828;
    }

    .book-actions {
        display: flex;
        justify-content: center;
        gap: 14px;
        margin-top: 20px;
    }

        .book-actions button,
        .book-actions a.btn {
            width: 40px;
            height: 40px;
            font-size: 18px;
            border-radius: 50%;
            border: 2px solid #d4af37;
            color: #4a3828;
            background-color: #fff9e8;
            transition: all 0.3s ease;
        }

            .book-actions button:hover,
            .book-actions a.btn:hover {
                background-color: #d4af37;
                color: white;
                transform: scale(1.2);
            }

    .favorite-icon {
        position: absolute;
        top: 15px;
        right: 15px;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.85);
        border: 2px solid #d4af37;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #d4af37;
        cursor: pointer;
        font-size: 20px;
        transition: all 0.4s ease;
        z-index: 5; /* kitab şəklinin üstündə qalmaq üçün */
    }

        .favorite-icon:hover {
            background: #d4af37;
            color: white;
            transform: rotate(20deg) scale(1.3);
        }
</style>

<div class="section-title">
    <h2>🌟 Premium Kitab Kataloqu</h2>
    <div class="underline"></div>
  
</div>

<div class="row mb-4">
    <div class="col-md-6 offset-md-3">
        <form method="get" asp-action="Search" asp-controller="PaidBook">
            <div class="input-group">
                <select name="searchTerm" class="form-select">
                    @if (ViewBag.Categories != null)
                    {
                        foreach (var category in ViewBag.Categories as List<string>)
                        {
                            <option value="@category">@category</option>
                        }
                    }
                    else
                    {
                        <option disabled>Kateqoriya tapılmadı</option>
                    }
                </select>
                <button type="submit" class="btn btn-outline-secondary">
                    <i class="bi bi-search"></i> Axtar
                </button>
            </div>
        </form>
    </div>
</div>

<div class="container">
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4 justify-content-center">
        @foreach (var book in Model)
        {
            <div class="col d-flex justify-content-center">
                <div class="book-card">

                    <form asp-action="AddToFavorites" asp-controller="Favorites" method="post">
                        <input type="hidden" name="id" value="@book.Id" />
                        <button type="submit" class="favorite-icon" title="Sevimli"> ❤️ </button>
                    </form>

                    @if (!string.IsNullOrEmpty(book.Img))
                    {
                        <a asp-controller="PaidBook" asp-action="Details" asp-route-id="@book.Id" title="@book.Title">
                            <img src="~/Imagess/@book.Img" class="book-image" alt="@book.Title" />
                        </a>
                    }
                    else
                    {
                        <div class="no-image">Şəkil yoxdur</div>
                    }

                    <div class="book-body">
                        <div class="book-meta">Qiymət: @book.Price ₼</div>
                    </div>

                    <div class="book-actions">
                        <form asp-action="AddToCart" asp-controller="Cart" asp-route-bookId="@book.Id" method="post">
                            <button type="submit" class="btn" title="Səbətə">🛒</button>
                        </form>

                        <form asp-action="ReadBook" asp-controller="PaidBook" method="post">
                            <input type="hidden" name="bookId" value="@book.Id" />
                            <button asp-route-pdfFileName="@book.Pdf" asp-action="GetFirst10Pages" type="submit" class="btn" title="Oxu">📖</button>
                        </form>

                        <form asp-action="Checkout" asp-controller="Payment" method="post">
                            <input type="hidden" name="bookId" value="@book.Id" />
                            <input type="hidden" name="amount" value="@book.Price" />
                            <a asp-controller="Checkout" asp-action="CreateCheckoutSession" asp-route-bookId="@book.Id" class="btn" title="Al">💳</a>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
}
