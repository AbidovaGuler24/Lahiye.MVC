@model List<OnlineLearning.Core.ViewModels.PaidBookVm>

@{
    Layout = null;
    ViewData["Title"] = "Books Gallery";
}

<!-- Bootstrap və ikon stil -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<style>
    body {
        background-color: #6f4e37;
        font-family: 'Segoe UI', sans-serif;
    }

    .card {
        background-color: #fffaf0;
        border: none;
        border-radius: 15px;
        transition: transform 0.3s ease;
    }

        .card:hover {
            transform: scale(1.02);
        }

    .card-img-top {
        max-height: 250px;
        width: 100%;
        object-fit: contain;
        border-top-left-radius: 15px;
        border-top-right-radius: 15px;
        background-color: #f8f8f8;
    }

    .card-body {
        padding: 15px;
    }

    .card-footer {
        background-color: transparent;
        border-top: none;
    }

    .pdf-frame {
        width: 100%;
        height: 500px;
        border: none;
        border-radius: 10px;
    }

    .btn-custom {
        background-color: #6f4e37;
        color: white;
    }

        .btn-custom:hover {
            background-color: #6f4e37;
        }

    /* PDF Modal */
    .pdf-modal {
        display: none;
        position: fixed;
        z-index: 1050;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.6);
        justify-content: center;
        align-items: center;
    }

    .pdf-content {
        background-color: white;
        padding: 20px;
        border-radius: 10px;
        max-width: 80%;
        max-height: 90%;
        overflow: auto;
        box-shadow: 0 0 10px rgba(0,0,0,0.5);
        position: relative;
    }
</style>

<div class="container mt-5">
    <h2 class="mb-4 text-center text-white">📘 Kitab Qalereyası</h2>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var book in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(book.Img))
                    {
                        <img src="@Url.Content("~/Imagess/" + book.Img)" class="card-img-top" alt="@book.Title" />
                    }
                    else
                    {
                        <div class="bg-light d-flex justify-content-center align-items-center" style="height: 250px;">
                            <span class="text-muted">Şəkil yoxdur</span>
                        </div>
                    }

                    <div class="card-body">
                        <h5 class="card-title">@book.Title</h5>
                       
                    </div>

                    <div class="card-footer d-flex justify-content-between align-items-center">
                        @if (!string.IsNullOrEmpty(book.Pdf))
                        {
                            <a href="javascript:void(0);" onclick="showPdf('@Url.Content("~/PDFs/" + book.Pdf)')" class="btn btn-outline-secondary btn-sm">
                                📖 Oxu
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">PDF yoxdur</span>
                        }

                        <button asp-action="Details" asp-controller="PaidBook" asp-route-id="@book.Id" class="btn btn-sm btn-outline-secondary">
                            Ətraflı
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- PDF Modal -->
@* <div id="pdfModal" class="pdf-modal d-flex">
    <div class="pdf-content">
        <button class="btn btn-sm btn-danger float-end mb-2" onclick="closePdf()">Bağla ✖</button>
        <a id="downloadPdfBtn" href="#" download class="btn btn-sm btn-success mb-2">
            <i class="bi bi-download"></i> Yüklə
        </a>
        <iframe id="pdfFrame" class="pdf-frame"></iframe>
    </div>
</div> *@

<script>
    function showPdf(pdfUrl) {
        const pdfModal = document.getElementById("pdfModal");
        const pdfFrame = document.getElementById("pdfFrame");
        const downloadBtn = document.getElementById("downloadPdfBtn");

        pdfFrame.src = pdfUrl;
        downloadBtn.href = pdfUrl;
        pdfModal.style.display = "flex";
    }

    function closePdf() {
        const pdfModal = document.getElementById("pdfModal");
        const pdfFrame = document.getElementById("pdfFrame");

        pdfModal.style.display = "none";
        pdfFrame.src = "";
    }
</script>
