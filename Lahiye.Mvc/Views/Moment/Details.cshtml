@using OnlineLearning.Core.ViewModels
@model OnlineLearning.Core.ViewModels.MomentViewModel

<h2>@Model.Title</h2>
<p>@Model.Description</p>

@{
    var commentvm = ViewBag.Comment as CommentViewModel;
}

@if (!string.IsNullOrEmpty(Model.ImagePath))
{

    <img src="~/imagess/@Model.ImagePath" alt="Alternate Text" style="width:100px; height:auto;" />
}


<h3>Yorumlar</h3>
@if (Model.Comments != null && Model.Comments.Any())
{
    <ul class="list-group">
        @foreach (var comment in Model.Comments)
        {
            <li class="list-group-item">
                <strong>@comment.UserName:</strong>
                <p>@comment.Content</p>
            </li>
        }
    </ul>
}
else
{
    <p>Hələ heç bir şərh yoxdur.</p>
}

<hr />
<h4>Yeni şərh əlavə et</h4>
<form   asp-action="AddComment" method="post">
    <input type="hidden" asp-for="@Model.Comment.MomentId"/>
 

    <div class="form-group">
        <label asp-for="@Model.Comment.UserName"></label>
        <input asp-for="@Model.Comment.UserName" class="form-control" />
        <span asp-validation-for="@Model.Comment.UserName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="@Model.Comment.Content"></label>
        <textarea asp-for="@Model.Comment.Content" class="form-control"></textarea>
        <span asp-validation-for="@Model.Comment.Content" class="text-danger"></span>
    </div>

    <button asp-action="AddComment" asp-route-id="@Model.Id" type="submit" class="btn btn-primary">Göndər</button>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
