
 @using OnlineLearning.Core.ViewModels
@using System.Text.Json
@model OnlineLearning.Core.ViewModels.MomentViewModel
@{
    Layout = null;
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    .moment-container {
        width: 1000px;
        margin: 30px auto;
        padding: 40px;
        background-color: #f5e9da;
        border-radius: 10px;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    }

    .moment-title {
        font-size: 36px;
        font-weight: bold;
        text-align: center;
        margin-bottom: 20px;
    }

    .row-custom {
        display: flex;
        gap: 20px;
        justify-content: space-between;
    }

    .moment-image {
        width: 400px;
        height: 450px;
        object-fit: cover;
        border-radius: 10px;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    }

    .comments-section {
        flex: 1;
        max-width: 550px;
    }

    .moment-description {
        font-size: 18px;
        margin-bottom: 30px;
    }

    .comments-title {
        font-size: 28px;
        font-weight: bold;
        margin-bottom: 15px;
        border-bottom: 2px solid #a67c52;
        padding-bottom: 5px;
    }

    .comment-item {
        margin-bottom: 15px;
        padding-bottom: 10px;
        border-bottom: 1px solid #ddd;
    }

    .comment-username {
        font-weight: bold;
        margin-bottom: 5px;
    }

    .comment-content {
        font-size: 16px;
        color: #555;
        white-space: pre-wrap;
    }

    .pagination-controls {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        margin-top: 15px;
    }

        .pagination-controls button {
            background-color: #a67c52;
            color: white;
            border: none;
            padding: 6px 14px;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
            transition: background-color 0.3s ease;
        }

            .pagination-controls button:disabled {
                background-color: #a67c52;
                cursor: not-allowed;
            }

            .pagination-controls button:hover:not(:disabled) {
                background-color: #a67c52;
            }

    .btn-back {
        display: inline-block;
        padding: 8px 20px;
        background-color: #a67c52;
        color: white;
        text-decoration: none;
        border-radius: 6px;
        font-weight: 600;
        margin-top: 30px;
        transition: background-color 0.3s ease;
    }

        .btn-back:hover {
            background-color: #a67c52;
        }
</style>

<div class="moment-container">
    <h2 class="moment-title">@Model.Title</h2>

    <div class="row-custom">
        @if (!string.IsNullOrEmpty(Model.ImagePath))
        {
            <img src="~/imagess/@Model.ImagePath" alt="Moment Image" class="moment-image" />
        }

        <div class="comments-section">
            <p class="moment-description">@Model.Description</p>

            <h3 class="comments-title">Yorumlar</h3>

            @if (Model.Comments != null && Model.Comments.Any())
            {
                <div id="commentsContainer"></div>

                <div class="pagination-controls">
                    <button id="prevPageBtn" disabled>Əvvəlki</button>
                    <span id="pageInfo"></span>
                    <button id="nextPageBtn">Növbəti</button>
                </div>

                <script>
                    // Configuration
                    const commentsPerPage = 1;
                    let currentPage = 1;

                    // Parse JSON string coming from server
                    const serverComments = JSON.parse('@Html.Raw(ViewBag.SComments)');
                    const comments = Array.isArray(serverComments) ? serverComments : [];
                    const totalPages = Math.max(1, Math.ceil(comments.length / commentsPerPage));

                    // DOM Elements
                    const commentsContainer = document.getElementById("commentsContainer");
                    const prevPageBtn = document.getElementById("prevPageBtn");
                    const nextPageBtn = document.getElementById("nextPageBtn");
                    const pageInfo = document.getElementById("pageInfo");

                    // Format date (optional, kullanmak istersen)
                    function formatDate(dateString) {
                        if (!dateString) return '';
                        const date = new Date(dateString);
                        return date.toLocaleDateString() + ' ' + date.toLocaleTimeString();
                    }

                    // Render current page comments
                    function renderComments() {
                        if (!commentsContainer) return;

                        const startIndex = (currentPage - 1) * commentsPerPage;
                        const comment = comments[startIndex];

                        commentsContainer.innerHTML = comment ? `
                            <div class="comment-item">
                                <div class="comment-username">${comment.UserName || 'Anonymous'}</div>
                                <div class="comment-content">${comment.Content || 'No content'}</div>
                                <div class="comment-createdAt">${formatDate(comment.CreatedAt)}</div>
                            </div>
                        ` : '<p class="text-muted">No comments found</p>';

                        updatePaginationControls();
                    }

                    // Update pagination buttons and info
                    function updatePaginationControls() {
                        if (!pageInfo || !prevPageBtn || !nextPageBtn) return;

                        pageInfo.textContent = `Yorum ${currentPage} / ${totalPages}`;
                        prevPageBtn.disabled = currentPage === 1;
                        nextPageBtn.disabled = currentPage === totalPages;

                        // Hide controls if only one page
                        if (totalPages <= 1) {
                            document.querySelector('.pagination-controls').style.display = 'none';
                        }
                    }

                    // Event listeners
                    if (prevPageBtn) {
                        prevPageBtn.addEventListener('click', () => {
                            if (currentPage > 1) {
                                currentPage--;
                                renderComments();
                            }
                        });
                    }

                    if (nextPageBtn) {
                        nextPageBtn.addEventListener('click', () => {
                            if (currentPage < totalPages) {
                                currentPage++;
                                renderComments();
                            }
                        });
                    }

                    // Initial render when DOM is ready
                    document.addEventListener('DOMContentLoaded', renderComments);
                </script>

            }
            else
            {
                <p class="text-center fst-italic text-muted">Hələ heç bir şərh yoxdur.</p>
            }
        </div>
    </div>

    <a asp-action="Index" asp-controller="Moment" class="btn-back mt-4">Geri dön</a>
</div>