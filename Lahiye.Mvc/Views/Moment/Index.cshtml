@model List<OnlineLearning.Core.Entities.Moment>

@{
    Layout = null;
    ViewData["Title"] = "Moments";
}
<!-- Bootstrap 5 CDN -->
<!-- Bootstrap 5 CDN -->
<!-- Bootstrap 5 CDN -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    body {
        background-color: #f5e9da;
        font-family: 'Georgia', serif;
        padding: 20px;
    }

    .container {
        display: flex;
        flex-direction: column;
        gap: 20px;
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }

    .allMoment {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        width: 100%;
    }


    .card {
        background-color: white;
        border-radius: 12px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
        margin: 30px auto;
        max-width: 600px;
        overflow: hidden;
        transition: transform 0.3s ease;
        width: 100%; 
    }

        .card:hover {
            transform: scale(1.02);
        }

    .card-header {
        background-color: transparent;
        border-bottom: none;
        padding: 1rem 1.5rem 0;
    }

        .card-header h4 {
            font-weight: bold;
            color: #333;
        }

    .card-body {
        padding: 1rem 1.5rem 2rem;
    }
    .card-body p {
        height:17%;
    }

    .card img {
        width: 100%;
        height: auto;
        display: block;
        border-radius: 8px;
        margin-bottom: 1rem;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
        border: 4px solid white;
    }

    .list-group-item {
        border: none;
        border-bottom: 1px solid #efefef;
        background-color: transparent;
    }

        .list-group-item:last-child {
            border-bottom: none;
        }

    .btn-primary, .btn-outline-primary {
        border-radius: 8px;
        font-weight: 600;
        padding: 8px 16px;
    }

        .btn-primary:hover, .btn-outline-primary:hover {
            opacity: 0.9;
        }

    .form-control {
        border-radius: 8px;
        border: 1px solid #ccc;
    }

        .form-control:focus {
            border-color: /* 999 */ #a67c52;
            
            box-shadow: none;
        }

    .card .collapse {
        margin-top: 15px;
    }

    h2 {
        text-align: center;
        font-weight: 700;
        color: #444;
        margin: 30px 0;
    }
</style>



@* <!-- Bootstrap CDN -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
 *@
<div class="container">
    <h2 class="mb-4 ">Xatirələrimizdən</h2>

    <div class="allMoment">
        @foreach (var moment in Model)
        {

            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-light">
                    <h4 class="mb-0">@moment.Title</h4>
                </div>
                <div class="card-body">
                    <p>@moment.Description</p>

                    @if (!string.IsNullOrEmpty(moment.ImagePath))
                    {
                        <a asp-action="Details" asp-controller="Moment" asp-route-id="@moment.Id">
                            <img src="~/imagess/@moment.ImagePath" alt="Moment Image" class="img-fluid rounded mb-3" style="max-width: 400px;" />
                        </a>
                    }
                    @*  <h5>Comments</h5>

            @if (moment.Comments != null && moment.Comments.Any())
            {
                <ul class="list-group mb-3">
                    @foreach (var comment in moment.Comments)
                    {
                        <li class="list-group-item">
                            <strong>@comment.UserName</strong> (@comment.CreatedAt.ToString("g")):
                            <p class="mb-0">@comment.Message</p>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted">No comments yet.</p>
            }
 *@
                    <!-- Yorum Et düyməsi -->
                    <button class="btn btn-outline-primary mb-2" type="button" data-bs-toggle="collapse" data-bs-target="#commentForm-@moment.Id">
                        Yorum et
                    </button>

                    <!-- Collapse ilə şərh formu -->
                    <div class="collapse" id="commentForm-@moment.Id">
                        <form asp-action="AddComment" asp-controller="Moment" asp-route-id="@moment.Id" method="post" class="mt-2">
                            <input type="hidden" name="MomentId" value="@moment.Id" />

                            <div class="form-group mb-2">
                                <input type="text" name="Comment.UserName" class="form-control" placeholder="Adınız" required />
                            </div>

                            <div class="form-group mb-2">
                                <textarea name="Comment.Content" class="form-control" rows="2" placeholder="Şərhiniz" required></textarea>
                            </div>

                            <button type="submit" class="btn btn-primary">Göndər</button>
                        </form>
                    </div>

                </div>
            </div>
        }

    </div>
    </div>



<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
