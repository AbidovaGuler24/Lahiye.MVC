@model List<OnlineLearning.Core.ViewModels.BlogVm>
@{
    Layout = "_Layout1";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Library Blog</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background: #f9f9f9;
            font-family: 'Segoe UI', sans-serif;
        }

        .header-banner {
            background: linear-gradient(rgba(111, 78, 55, 0.7), rgba(111, 78, 55, 0.7)), url('/images/banner/library-banner.jpg') center/cover no-repeat;
            color: white;
            padding: 80px 0;
            text-align: center;
        }

            .header-banner h1 {
                font-size: 3rem;
                margin-bottom: 10px;
                color: #fff8f0;
            }

            .header-banner p {
                font-size: 1.2rem;
                color: #f0e5dd;
            }

        .blog-card {
            background-color: #fff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            transition: transform 0.3s ease;
        }

            .blog-card:hover {
                transform: translateY(-5px);
            }

            .blog-card img {
                width: 100%;
                height: 220px;
                object-fit: cover;
            }

        .blog-body {
            padding: 20px;
        }

            .blog-body p {
                margin-bottom: 0;
            }

        .blog-footer {
            padding: 0 20px 20px;
        }

        .btn-custom {
            background-color: #6f4e37;
            color: white;
            border-radius: 30px;
            padding: 8px 20px;
            border: none;
        }

            .btn-custom:hover {
                background-color: #563c2b;
            }

        .btn-outline-dark {
            border-color: #6f4e37;
            color: #6f4e37;
        }

            .btn-outline-dark:hover {
                background-color: #6f4e37;
                color: white;
            }
    </style>

</head>
<body>

    <section class="header-banner">
        <div class="container">
            <h1>Library Blog</h1>
            <p>A cozy corner for curious minds and book lovers.</p>
        </div>
    </section>

    <section class="py-5">
        <div class="container">
            <div class="row">
                @if (Model != null && Model.Any())
                {
                    foreach (var blog in Model)
                    {
                        <div class="col-md-6 col-lg-4 mb-4">
                            <div class="blog-card">
                                <img src="~/Imagess/@blog.Img" alt="@blog.Description" />
                                <div class="blog-body">
                                    <p class="text-muted small">#LibraryPost</p>
                                    <p>@blog.Description</p>
                                </div>
                                <div class="blog-footer">
                                    <a href="/blog/details/@blog.Id" class="btn btn-custom btn-sm">Read More</a>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center">
                        <p>No blog posts found.</p>
                    </div>
                }
            </div>

           
        </div>
    </section>

</body>
</html>
