@model List<OnlineLearning.Core.ViewModels.FavoriteBookVM>

@{
    Layout = "_Layout1";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    body {
        background-color: #f5f1ea;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        padding: 30px 20px;
    }

    .section-title {
        text-align: center;
        color: #6b5e44;
        margin-bottom: 2rem;
    }

        .section-title h2 {
            font-weight: 600;
            font-size: 2rem;
        }

    .underline {
        width: 80px;
        height: 3px;
        background-color: #b07a5a;
        margin: 8px auto 24px;
        border-radius: 2px;
    }

    .books-container {
        display: flex;
        flex-wrap: wrap;
        gap: 24px;
        justify-content: center;
        max-width: 1200px;
        margin: 0 auto;
    }

    .book-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        width: 180px;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 12px 12px 18px;
        position: relative;
        transition: box-shadow 0.3s ease, transform 0.3s ease;
    }

        .book-card:hover {
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
            transform: translateY(-6px);
        }

    .book-image {
        width: 100%;
        height: 240px;
        object-fit: cover;
        border-radius: 10px;
        margin-bottom: 14px;
        transition: transform 0.3s ease;
    }

    .book-card:hover .book-image {
        transform: scale(1.05);
    }

    .book-title {
        font-weight: 600;
        font-size: 16px;
        color: #4a3e2a;
        min-height: 48px;
        margin-bottom: 10px;
        text-align: center;
    }

    .book-price {
        font-weight: 700;
        color: #a46f2c;
        font-size: 16px;
        margin-bottom: 14px;
    }

    .button-group {
        display: flex;
        gap: 8px;
        justify-content: center;
        margin-top: 6px;
    }

    .no-books {
        font-size: 18px;
        color: #7b624b;
        text-align: center;
        width: 100%;
        padding: 50px 0;
    }

    .favorite-button {
        position: absolute;
        top: 12px;
        right: 12px;
        background: transparent;
        border: none;
        font-size: 24px;
        cursor: pointer;
        color: #b07a5a;
        transition: transform 0.3s ease;
        z-index: 2;
    }

        .favorite-button:hover {
            transform: scale(1.2);
            color: red;
        }

    button.add-to-cart, button.buy-now {
        width: 36px;
        height: 36px;
        font-size: 20px;
        color: #b07a5a;
        border: 2px solid #b07a5a;
        background: transparent;
        border-radius: 50%;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        button.add-to-cart:hover, button.buy-now:hover {
            background-color: #b07a5a;
            color: white;
            transform: scale(1.2);
        }
</style>

<div class="section-title">
    <h2>❤️ Favorit Kitablarınız</h2>
    <div class="underline"></div>
    <p>Sevdiyiniz kitabları burada rahatlıqla idarə edin</p>
</div>

<div class="books-container">
    @if (!Model.Any())
    {
        <p class="no-books">Favorit kitab yoxdur.</p>
    }
    else
    {
        @foreach (var book in Model)
        {
            <div class="book-card" data-book-id="@book.BookId">
                <!-- Favoritdən silmə form -->
               
                @if (!string.IsNullOrEmpty(book.CoverImage))
                {
                    <a asp-action="Details" asp-controller="PaidBook" asp-route-id="@book.BookId">
                        <img src="~/Imagess/@book.CoverImage" alt="@book.BookTitle" class="book-image" />
                    </a>
                }
                else
                {
                    <a asp-action="Details" asp-controller="PaidBook" asp-route-id="@book.BookId" style="display:flex;align-items:center;justify-content:center;width:100%;height:240px;background:#eae6dd;border-radius:10px;color:#999;font-style:italic;text-decoration:none;">
                        Şəkil yoxdur
                    </a>
                }

                <div class="book-title">@book.BookTitle</div>
                <div class="book-price">@book.Price ₼</div>

                <div class="button-group">

                    <form asp-action="AddToCart" asp-controller="Cart" asp-route-bookId="@book.BookId" method="post" style="margin:0;">
                        <button type="submit" class="add-to-cart" title="Səbətə əlavə et">🛒</button>
                    </form>

                    <form asp-action="BuyNow" asp-controller="Cart" asp-route-bookId="@book.BookId" method="post" style="margin:0;">
                        <button type="submit" class="buy-now" title="Birbaşa al">💳</button>
                    </form>

                    <form asp-action="RemoveFromFavorites" asp-controller="Favorites" asp-route-id="@book.Id" method="post" style="margin:0;">
                        <button type="submit" class="buy-now" title="Cixart">-</button>
                    </form>

                </div>
            </div>
        }
    }
</div>
