@using OnlineLearning.Core.Entities
@model List<PaidBook>

@{
    ViewData["Title"] = "My Cart";
}

<h2>My Cart</h2>

@if (Model == null || !Model.Any())
{
    <p>Your cart is empty.</p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Book Title</th>
                <th>Price</th>
              
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model)
            {
                <tr>
                    <td>@book.Title</td>

                    <td>@book.Price.ToString("0.00") ₼</td>
                    <td>@book.</td>
                    <td>
                        <a asp-controller="Checkout" asp-action="CreateCheckoutSession" asp-route-bookId="@book.Id" class="btn btn-success">Buy Now</a>
                        <a asp-action="RemoveFromCart" asp-route-id="@book.Id" class="btn btn-danger">Remove</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
