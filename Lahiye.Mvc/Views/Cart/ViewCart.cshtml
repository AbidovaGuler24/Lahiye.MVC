@model List<OnlineLearning.Core.Entities.CartItem>
@{
    Layout = null;
}
<style>
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: #f8f3ed; /* yumşaq bej */
        color: #4c3b2e; /* tünd qəhvəyi */
        margin: 30px 15px;
    }

    .cart-container {
        max-width: 900px;
        margin: 0 auto;
        background: #fffaf5; /* çox açıq krem-bej */
        padding: 30px 25px;
        border-radius: 12px;
        box-shadow: 0 6px 22px rgba(134, 92, 59, 0.18);
    }

    h2 {
        text-align: center;
        color: #865c3b; /* orta tünd qəhvəyi */
        margin-bottom: 30px;
        font-weight: 700;
        font-size: 2rem;
        letter-spacing: 1.1px;
    }

    thead tr th {
        background-color: #c4a67a; /* yumşaq qəhvəyi-bej */
        color: #4c3b2e;
        padding: 15px 20px;
        text-align: left;
        border-radius: 8px 8px 0 0;
        font-weight: 600;
        user-select: none;
    }

    tbody tr {
        background: #e6dacf; /* yüngül qəhvəyi-bej */
        box-shadow: 0 3px 8px rgba(134, 92, 59, 0.15);
        border-radius: 12px;
        transition: box-shadow 0.3s ease;
    }

        tbody tr:hover {
            box-shadow: 0 6px 22px rgba(134, 92, 59, 0.3);
        }

        tbody tr td {
            padding: 15px 20px;
            vertical-align: middle;
            color: #4c3b2e;
            font-weight: 500;
            border-top: 1px solid #d6c9b3;
        }

            tbody tr td:first-child {
                width: 100px;
                padding-top: 10px;
                padding-bottom: 10px;
            }

            tbody tr td img {
                width: 70px;
                height: 105px;
                object-fit: cover;
                border-radius: 6px;
                box-shadow: 0 0 6px rgba(134, 92, 59, 0.12);
            }

            tbody tr td:nth-child(3),
            tbody tr td:nth-child(4),
            tbody tr td:nth-child(5) {
                text-align: right;
                font-weight: 600;
                color: #865c3b;
                min-width: 90px;
            }

            tbody tr td:nth-child(6) {
                text-align: center;
                min-width: 140px;
            }

    button.btn {
        cursor: pointer;
        padding: 10px 22px;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.95rem;
        color: white;
        box-shadow: 0 4px 12px rgba(134, 92, 59, 0.4);
        transition: background-color 0.3s ease;
        margin: 0 6px;
        min-width: 90px;
    }

    button.btn-add {
        background-color: #865c3b;
    }

        button.btn-add:hover {
            background-color: #704c2e;
        }

    button.btn-remove {
        background-color: #b2875a;
    }

        button.btn-remove:hover {
            background-color: #a0764a;
        }

    .cart-footer {
        margin-top: 35px;
        padding-top: 20px;
        border-top: 2px solid #d6c9b3;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-weight: 700;
        font-size: 1.3rem;
        color: #865c3b;
    }

        .cart-footer button {
            background-color: #865c3b;
            padding: 12px 30px;
            border-radius: 10px;
            box-shadow: 0 5

</style>

<div class="cart-container" role="main" aria-label="Shopping Cart">
    <h2>Shopping Cart</h2>

    <table class="cart-table" aria-describedby="cartSummary">
        <thead>
            <tr>
                <th>Img</th>
                <th scope="col">Book Title</th>
                <th scope="col" style="width: 80px;">Quantity</th>
                <th scope="col">Price</th>
                <th scope="col">Total</th>
                <th scope="col" style="width: 140px;">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <img src="@(item.PaidBook?.Img != null ? Url.Content("~/imagess/" + item.PaidBook.Img) : Url.Content("~/imagess/default-book.jpg"))"
                             alt="@item.PaidBook?.Title ?? " Default Book Image"" />
                    </td>
                    <td>@item.PaidBook?.Title</td>
                    <td>@item.Quantity</td>
                    <td>@item.PaidBook?.Price.ToString("C")</td>
                    <td>@((item.PaidBook.Price * item.Quantity).ToString("C"))</td>
                    <td>
                        <button class="btn btn-add"
                                type="button"
                                onclick="addSingleItem(@item.PaidBookId)">
                            Add One
                        </button>
                        <button class="btn btn-remove"
                                type="button"
                                onclick="removeItem(@item.Id)">
                            Remove
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div id="cartSummary" class="cart-footer" aria-live="polite" aria-atomic="true">
        <div>
            Total:
            @Model.Sum(i => i.PaidBook.Price * i.Quantity).ToString("C")
        </div>
        <button class="btn btn-add" type="button" onclick="checkoutAll()">Buy All</button>
    </div>
</div>

<script>
    function addSingleItem(paidBookId) {
        alert('Add one more item with PaidBookId: ' + paidBookId);
        // Burada backendə POST sorğu göndərə bilərsən
    }

    function removeItem(cartItemId) {
        if (confirm("Are you sure to remove this item?")) {
            alert('Remove item with CartItemId: ' + cartItemId);
            // Burada backendə POST/DELETE sorğu göndərə bilərsən
        }
    }

    function checkoutAll() {
        alert("Proceeding to checkout all items.");
        // Checkout funksiyasını işə sal
    }
</script>
