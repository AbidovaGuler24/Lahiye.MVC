        margin: 0 6px;
        min-width: 90px;
    }

    button.btn-add {
        background-color: #865c3b;
    }

        button.btn-add:hover {
            background-color: #704c2e;
        }

    button.btn-remove {
        background-color: #b2875a;
    }

        button.btn-remove:hover {
            background-color: #a0764a;
        }

    .cart-footer {
        margin-top: 35px;
        padding-top: 20px;
        border-top: 2px solid #d6c9b3;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-weight: 700;
        font-size: 1.3rem;
        color: #865c3b;
    }

