
﻿@using Microsoft.Extensions.Options
@using OnlineLearning.Core.Entities

@model List<OnlineLearning.Core.Entities.CartItem>
@inject IOptions<StripeSettings> Stripe


@{
    Layout = null;
}
<style>
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;

        background-color: #faf7f1;
        color: #4a3a27;
        margin: 40px 20px;

    }

    .cart-container {
        max-width: 900px;

        margin: auto;
        background-color: #fff8ed;
        padding: 32px 28px;
        border-radius: 14px;
        box-shadow: 0 8px 24px rgba(130, 85, 40, 0.18);

    }

    h2 {
        text-align: center;

        color: #7f5a2a;
        font-size: 2.25rem;
        font-weight: 800;
        letter-spacing: 1.15px;
        margin-bottom: 36px;
        user-select: none;
    }

    table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 14px;
    }

    thead th {
        background-color: #b89562;
        color: #3f2e1c;
        padding: 16px 24px;
        font-weight: 700;
        border-radius: 10px 10px 0 0;
        user-select: none;
        text-align: left;
    }

    tbody tr {
        background-color: #eaddc8;
        box-shadow: 0 4px 16px rgba(130, 85, 40, 0.12);
        border-radius: 14px;
        transition: box-shadow 0.35s ease;
    }

        tbody tr:hover {
            box-shadow: 0 8px 32px rgba(130, 85, 40, 0.28);
        }

    tbody td {
        padding: 16px 24px;
        vertical-align: middle;
        color: #4a3a27;
        font-weight: 600;
        border-top: 1px solid #d6c9b3;
    }

        tbody td:first-child {
            width: 110px;
            padding-top: 12px;
            padding-bottom: 12px;
        }

        tbody td img {
            width: 72px;
            height: 108px;
            object-fit: cover;
            border-radius: 8px;
            box-shadow: 0 0 8px rgba(130, 85, 40, 0.10);
        }

        tbody td:nth-child(3),
        tbody td:nth-child(4),
        tbody td:nth-child(5) {
            text-align: right;
            font-weight: 700;
            color: #7f5a2a;
            min-width: 90px;
        }

        tbody td:nth-child(6) {
            text-align: center;
            min-width: 150px;
        }

    button.btn {
        cursor: pointer;
        padding: 10px 26px;
        border: none;
        border-radius: 10px;
        font-weight: 700;
        font-size: 1rem;
        color: white;
        box-shadow: 0 5px 14px rgba(130, 85, 40, 0.45);
        transition: background-color 0.35s ease;
        margin: 0 8px;
        min-width: 100px;
    }

    button.btn-add {
        background-color: #7f5a2a;
    }

        button.btn-add:hover {
            background-color: #6a4721;
        }

    button.btn-remove {
        background-color: #b59a6a;
    }

        button.btn-remove:hover {
            background-color: #a38a5d;
        }

    .cart-footer {
        margin-top: 40px;
        padding-top: 24px;
        border-top: 3px solid #d6c9b3;
        display: flex;
        flex-direction: column;
        align-items: center;
        font-weight: 800;
        font-size: 1.45rem;
        color: #7f5a2a;
        user-select: none;
    }

        .cart-footer .total {
            margin-bottom: 28px;
        }

    /* Responsive */
    @@media (max-width: 700px) {
        tbody td:first-child, tbody td:nth-child(6)

    {
        display: none;
    }

    tbody td:nth-child(2) {
        font-size: 1.1rem;
        font-weight: 700;
    }

        color: #865c3b; /* orta tünd qəhvəyi */
        margin-bottom: 30px;
        font-weight: 700;
        font-size: 2rem;
        letter-spacing: 1.1px;
    }

    thead tr th {
