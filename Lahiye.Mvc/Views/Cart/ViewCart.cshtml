@model List<OnlineLearning.Core.Entities.CartItem>
@{
    Layout = null;
  } 
<style>
    /* Ümumi tərz */
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: #f9fafb;
        color: #333;
        margin: 30px 0;
    }

    .cart-container {
        max-width: 1000px;
        margin: 0 auto;
        background: white;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 8px 25px rgb(0 0 0 / 0.1);
    }

    h2 {
        text-align: center;
        color: #0d6efd;
        margin-bottom: 25px;
        font-weight: 700;
        letter-spacing: 1.1px;
    }

    table.cart-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 12px;
    }

    thead tr th {
        text-align: left;
        padding: 12px 20px;
        background: #0d6efd;
        color: white;
        font-weight: 600;
        border-radius: 8px 8px 0 0;
        user-select: none;
    }

    tbody tr {
        background: #f1f5ff;
        box-shadow: 0 3px 6px rgb(13 110 253 / 0.15);
        border-radius: 12px;
        transition: box-shadow 0.3s ease;
    }

        tbody tr:hover {
            box-shadow: 0 8px 20px rgb(13 110 253 / 0.3);
        }

        tbody tr td {
            padding: 15px 20px;
            vertical-align: middle;
            color: #444;
            font-weight: 500;
        }

            tbody tr td:nth-child(3),
            tbody tr td:nth-child(4) {
                text-align: right;
                font-weight: 700;
                color: #0b4ed9;
                min-width: 90px;
            }

            tbody tr td:nth-child(5) {
                text-align: center;
                min-width: 120px;
            }

    /* Düymələr */
    button.btn {
        cursor: pointer;
        padding: 8px 16px;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        transition: background-color 0.25s ease;
        font-size: 0.9rem;
        color: white;
        box-shadow: 0 4px 8px rgb(13 110 253 / 0.3);
    }

    button.btn-add {
        background-color: #198754;
    }

        button.btn-add:hover {
            background-color: #157347;
        }

    button.btn-remove {
        background-color: #dc3545;
    }

        button.btn-remove:hover {
            background-color: #b02a37;
        }

    /* Ümumi bottom section */
    .cart-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 25px;
        border-top: 2px solid #e0e6ff;
        font-size: 1.2rem;
        font-weight: 700;
        color: #0d6efd;
    }

        .cart-footer button {
            padding: 12px 25px;
            font-size: 1.1rem;
            border-radius: 8px;
        }

    /* Responsive */
    @@media (max-width: 720px) {
        tbody tr td:nth-child(3), tbody tr td:nth-child(4)

    {
        text-align: left;
    }

    .cart-footer {
        flex-direction: column;
        gap: 15px;
        text-align: center;
    }

    }
</style>

<div class="cart-container" role="main" aria-label="Shopping Cart">
    <h2>Shopping Cart</h2>

    <table class="cart-table" aria-describedby="cartSummary">
        <thead>
            <tr>
                <th>Img</th>
                <th scope="col">Book Title</th>
                <th scope="col" style="width: 80px;">Quantity</th>
                <th scope="col">Price</th>
                <th scope="col">Total</th>
                <th scope="col" style="width: 140px;">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="p-4 flex items-center gap-4">
                        <img src="@(item.PaidBook?.Img != null ? Url.Content("~/imagess/" + item.PaidBook.Img) : Url.Content("~/imagess/default-book.jpg"))"
                             alt="Book Image"
                             class="w-16 h-24 object-cover rounded shadow" />
                        
                    </td>
                    <td>@item.PaidBook.Title</td>
                    <td>@item.Quantity</td>
                    <td>@item.PaidBook.Price.ToString("C")</td>
                    <td>@((item.PaidBook.Price * item.Quantity).ToString("C"))</td>
                    <td>
                        <button class="btn btn-add"
                                type="button"
                                onclick="addSingleItem(@item.PaidBookId)">
                            Add One
                        </button>
                        <button class="btn btn-remove"
                                type="button"
                                onclick="removeItem(@item.Id)">
                            Remove
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div id="cartSummary" class="cart-footer" aria-live="polite" aria-atomic="true">
        <div>
            Total:
            @Model.Sum(i => i.PaidBook.Price * i.Quantity).ToString("C")
        </div>
        <button class="btn btn-add" type="button" onclick="checkoutAll()">Buy All</button>
    </div>
</div>

<script>
    // Bu hissədə async çağırışlar yazıb backendə sorğu göndərə bilərsən.
    // Nümunə alert-lərlə göstərirəm.

    function addSingleItem(paidBookId) {
        alert('Add one more item with PaidBookId: ' + paidBookId);
        // Burada AJAX / fetch ilə backendə POST sorğu göndər
    }

    function removeItem(cartItemId) {
        alert('Remove cart item with Id: ' + cartItemId);
        // Burada AJAX / fetch ilə backendə DELETE sorğu göndər
    }

    function checkoutAll() {
        alert('Proceed to buy all items in cart!');
        // Burada checkout səhifəsinə yönləndir və ya backendə sorğu at
    }
</script>
