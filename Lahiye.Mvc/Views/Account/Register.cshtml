@model OnlineLearning.Core.ViewModels.RegisterViewModel

@{
    Layout = null;
    ViewData["Title"] = "Register";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    body {
        background: linear-gradient(135deg, #f5f1e9, #d9c8b6);
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        margin: 0;
        padding: 0;
    }

    .card-register {
        background: #fff8f0;
        border-radius: 20px;
        box-shadow: 0 5px 15px rgba(121,85,72,0.15);
        padding: 2rem 2.5rem;
        max-width: 450px;
        width: 100%;
        transition: box-shadow 0.3s;
    }

        .card-register:hover {
            box-shadow: 0 10px 30px rgba(121,85,72,0.25);
        }

    h2 {
        color: #6d4c41;
        font-weight: 700;
        margin-bottom: 1.7rem;
        text-align: center;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    label {
        color: #8d6e63;
        font-weight: 600;
    }

    .form-control {
        border: none;
        border-radius: 12px;
        background: #fef8f4;
        padding: 0.8rem 1rem;
        box-shadow: inset 0 0 6px rgba(209,196,182,0.3);
        color: #5d4037;
        font-size: 1rem;
        transition: box-shadow 0.3s, background 0.3s;
    }

        .form-control::placeholder {
            color: #a1887f;
            font-style: italic;
        }

        .form-control:focus {
            outline: none;
            background: #fff;
            box-shadow: 0 0 10px 2px rgba(161,136,127,0.4);
            color: #3e2723;
        }

    .btn-success {
        background: linear-gradient(45deg, #a8bba8, #6d876d);
        border: none;
        border-radius: 40px;
        font-weight: 700;
        letter-spacing: 0.08em;
        padding: 0.75rem 1rem;
        box-shadow: 0 7px 20px rgba(109,135,109,0.45);
        color: #fff;
        font-size: 1rem;
        transition: background 0.3s, box-shadow 0.3s;
    }

        .btn-success:hover {
            background: linear-gradient(45deg, #6d876d, #a8bba8);
            box-shadow: 0 10px 28px rgba(109,135,109,0.7);
        }

    .text-center a {
        color: #8d6e63;
        font-weight: 600;
        text-decoration: none;
        transition: color 0.3s;
    }

        .text-center a:hover {
            color: #6d4c41;
            text-decoration: underline;
        }

    span.text-danger {
        font-size: 0.85rem;
        font-weight: 600;
    }

    .mb-4 {
        margin-bottom: 1.3rem !important;
    }

    /* Yeni stil: Ad və Soyad yan-yana */
    .row-inline {
        display: flex;
        gap: 1rem;
        margin-bottom: 1.3rem;
    }

        .row-inline > div {
            flex: 1;
            display: flex;
            flex-direction: column;
        }
</style>

<div class="card-register shadow-sm">
    <h2>Qeydiyyat</h2>

    <form asp-action="Register" method="post" novalidate>
        <div class="row-inline">
            <div>
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control" placeholder="Ad" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div>
                <label asp-for="Surname"></label>
                <input asp-for="Surname" class="form-control" placeholder="Soyad" />
                <span asp-validation-for="Surname" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-4">
            <label asp-for="Username"></label>
            <input asp-for="Username" class="form-control" placeholder="İstifadəçi adı" />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Email"></label>
            <input asp-for="Email" class="form-control" placeholder="Email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Password"></label>
            <input asp-for="Password" type="password" class="form-control" placeholder="Şifrə" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Şifrənin təsdiqi" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success w-100">Qeydiyyatdan keç</button>
    </form>

    <div class="mt-3 text-center">
        Hesabınız var? <a asp-action="Login">Daxil olun</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
