@model OnlineLearning.Core.ViewModels.LoginViewModel

@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    body {
        background: linear-gradient(135deg, #f5f1e9, #d9c8b6);
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .card-login {
        background-color: #fff8f0;
        border-radius: 15px;
        box-shadow: 0 8px 25px rgba(121, 85, 72, 0.15);
        padding: 2.5rem 2.5rem;
        width: 100%;
        max-width: 400px;
        transition: transform 0.3s ease;
    }

        .card-login:hover {
            transform: translateY(-4px);
            box-shadow: 0 15px 40px rgba(121, 85, 72, 0.25);
        }

    h2 {
        font-weight: 700;
        color: #6d4c41; /* qəhvəyi */
        margin-bottom: 1.7rem;
    }

    label {
        font-weight: 600;
        color: #8d6e63; /* bej qəhvəyi */
    }

    .form-control {
        border: 1.5px solid #d7ccc8;
        background-color: #fdf6f0;
        color: #5d4037;
        transition: border-color 0.3s ease;
    }

        .form-control:focus {
            border-color: #a1887f;
            box-shadow: 0 0 8px rgba(161, 136, 127, 0.4);
            background-color: #fff;
            color: #3e2723;
        }

    .btn-primary {
        background: linear-gradient(45deg, #a1887f, #6d4c41);
        border: none;
        font-weight: 600;
        letter-spacing: 0.05em;
        padding: 0.65rem 1rem;
        box-shadow: 0 5px 15px rgba(109, 76, 65, 0.5);
        transition: background 0.3s ease;
        color: #fff;
    }

        .btn-primary:hover {
            background: linear-gradient(45deg, #6d4c41, #a1887f);
            box-shadow: 0 8px 20px rgba(109, 76, 65, 0.7);
            color: #fff;
        }

    .form-check-label {
        color: #6d4c41;
        user-select: none;
    }

    .text-center a {
        color: #8d6e63;
        font-weight: 600;
        text-decoration: none;
        transition: color 0.3s ease;
    }

        .text-center a:hover {
            color: #6d4c41;
            text-decoration: underline;
        }

    span.text-danger {
        font-size: 0.85rem;
    }
</style>

<div class="card-login shadow-sm">
    <h2 class="text-center">Giriş</h2>
    <div asp-validation-summary="ModelOnly"></div>

    <form asp-action="Login" method="post" novalidate>
        <div class="mb-4">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control form-control-lg" placeholder="Email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" type="password" class="form-control form-control-lg" placeholder="Şifrə" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="mb-4 form-check">
            <input asp-for="IsRememberMe" class="form-check-input" type="checkbox" id="rememberMeCheck" />
            <label asp-for="IsRememberMe" class="form-check-label">Məni xatırla</label>
        </div>

        <button type="submit" class="btn btn-primary w-100">Daxil ol</button>
    </form>

    <div class="mt-4 text-center">
        Hesabınız yoxdur? <a asp-action="Register">Qeydiyyatdan keçin</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
