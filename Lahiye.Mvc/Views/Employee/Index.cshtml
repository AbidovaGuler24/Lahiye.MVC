@model List<OnlineLearning.Core.ViewModels.EmployeeVM>
@{
    Layout = "_Layout1";
}

@{
    ViewData["Title"] = "Komandamız";
}

<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;700&display=swap" rel="stylesheet">

<h2 class="title">@ViewData["Title"]</h2>

<div class="container">
    <div class="grid">
        @foreach (var employee in Model)
        {
            <div class="card">
                @if (!string.IsNullOrEmpty(employee.PhotoPath))
                {
                    <img src="~/imagess/@employee.PhotoPath" alt="@employee.FullName" class="photo" />
                }
                else
                {
                    <div class="no-photo">No Photo</div>
                }
                <div class="info">
                    <h3>@employee.FullName</h3>
                    <p class="position">@employee.Position</p>
                </div>
            </div>
        }
    </div>
</div>

<div class="join-us">
    <h3>🎓 Bilik dünyamıza sən də qatıl!</h3>
    <div class="buttons">
        <a href="/Employee/Add" class="btn">📎 CV-ni göndər</a>
    </div>
</div>

<style>
    body {
        margin: 0;
        font-family: 'Nunito', sans-serif;
        background: #f9f6f1; /* yumşaq bej fon */
        color: #3e3e3e;
    }

    .title {
        text-align: center;
        font-weight: 700;
        font-size: 2.8rem;
        margin: 2rem 0;
        color: #5a4a3c; /* qəhvə-bej ton */
        letter-spacing: 1px;
    }

    .container {
        max-width: 1200px;
        margin: auto;
        padding: 0 20px;
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2rem;
    }

    .card {
        background: #fffaf4; /* bej-ağ kart */
        border-radius: 15px;
        box-shadow: 0 4px 12px rgba(90, 74, 60, 0.15);
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        display: flex;
        flex-direction: column;
    }

        .card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 25px rgba(90, 74, 60, 0.3);
        }

    .photo {
        width: 100%;
        height: 280px;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .card:hover .photo {
        transform: scale(1.04);
    }

    .no-photo {
        height: 280px;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #efe6dc;
        color: #7a6a56;
        font-size: 1.3rem;
        font-style: italic;
    }

    .info {
        padding: 1.2rem;
        text-align: center;
    }

        .info h3 {
            margin: 0 0 0.5rem;
            font-size: 1.5rem;
            font-weight: 700;
            color: #5a4a3c;
        }

        .info .position {
            margin: 0;
            font-size: 1rem;
            font-weight: 500;
            color: #a67c52; /* isti bej-qəhvə vurğu */
            text-transform: uppercase;
            letter-spacing: 1px;
        }

    .join-us {
        text-align: center;
        margin: 4rem 0;
        color: #5a4a3c;
    }

        .join-us h3 {
            font-size: 2rem;
            margin-bottom: 1.2rem;
        }

    .buttons {
        display: flex;
        justify-content: center;
    }

    .btn {
        background: #a67c52;
        color: #fff;
        padding: 14px 36px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        transition: background 0.3s ease, box-shadow 0.3s ease;
    }

        .btn:hover {
            background: #8c6239;
            box-shadow: 0 6px 20px rgba(140, 98, 57, 0.4);
        }

    @@media (max-width: 768px) {
        .photo, .no-photo

    {
        height: 220px;
    }

    }

    @@media (max-width: 480px) {
        .photo, .no-photo

    {
        height: 160px;
    }

    .title {
        font-size: 2rem;
    }

    }
</style>
