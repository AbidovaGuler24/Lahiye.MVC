@model OnlineLearning.Core.ViewModels.EmployeeAddVm
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <title>Kitabxana - İşçi Əlavə Et</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Tailwind CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body {
            font-family: "Georgia", serif; 
        }
    </style>
</head>
<body class="bg-[#fdf6e3] min-h-screen flex items-center justify-center">
    <div class="bg-[#fffaf0] shadow-2xl rounded-3xl p-10 w-full max-w-lg border border-[#d2b48c]">
        <h3 class="text-3xl font-bold text-center mb-8 text-[#5a3e1b]">İşçi Əlavə Et</h3>

        <form asp-action="Add" method="post" enctype="multipart/form-data" class="space-y-6">
            <div>
                <label asp-for="Email" class="block mb-1 text-[#5a3e1b] font-semibold"></label>
                <input asp-for="Email" class="w-full px-4 py-2 border-2 border-[#d2b48c] rounded-xl focus:outline-none focus:border-[#8b5e3c] bg-[#fffaf0]" />
                <span asp-validation-for="Email" class="text-red-500 text-sm"></span>
            </div>

            <div>
                <label asp-for="Name" class="block mb-1 text-[#5a3e1b] font-semibold"></label>
                <input asp-for="Name" class="w-full px-4 py-2 border-2 border-[#d2b48c] rounded-xl focus:outline-none focus:border-[#8b5e3c] bg-[#fffaf0]" />
                <span asp-validation-for="Name" class="text-red-500 text-sm"></span>
            </div>

            <div>
                <label asp-for="Position" class="block mb-1 text-[#5a3e1b] font-semibold"></label>
                <input asp-for="Position" class="w-full px-4 py-2 border-2 border-[#d2b48c] rounded-xl focus:outline-none focus:border-[#8b5e3c] bg-[#fffaf0]" />
                <span asp-validation-for="Position" class="text-red-500 text-sm"></span>
            </div>

            <div>
                <label asp-for="PhotoFile" class="block mb-1 text-[#5a3e1b] font-semibold">Şəkil (isteğe bağlı)</label>
                <input asp-for="PhotoFile" type="file" accept="image/*" class="w-full file:px-4 file:py-2 file:border-0 file:rounded-xl file:bg-[#d2b48c] file:text-[#fffaf0] hover:file:bg-[#8b5e3c] bg-[#fffaf0]" />
                <span asp-validation-for="PhotoFile" class="text-red-500 text-sm"></span>
            </div>

            <div>
                <label asp-for="CvFile" class="block mb-1 text-[#5a3e1b] font-semibold">CV (yalnız PDF)</label>
                <input asp-for="CvFile" type="file" accept="application/pdf" class="w-full file:px-4 file:py-2 file:border-0 file:rounded-xl file:bg-[#d2b48c] file:text-[#fffaf0] hover:file:bg-[#8b5e3c] bg-[#fffaf0]" />
                <span asp-validation-for="CvFile" class="text-red-500 text-sm"></span>
            </div>

            <button type="submit" class="w-full bg-[#5a3e1b] text-white py-3 rounded-xl font-bold hover:bg-[#3e2a14] transition">Göndər</button>
        </form>

        <div class="mt-8 text-center text-[#5a3e1b] text-sm italic">
            &copy; @DateTime.Now.Year Kitabxana Sistemi
        </div>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>
