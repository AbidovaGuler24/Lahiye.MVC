@model List<OnlineLearning.Core.ViewModels.BookVm>
@{
    Layout = "_Layout1";
    ViewData["Title"] = "Kitab Qalereyası";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<style>
    body {
        background-color: #f9f6f1;
        font-family: 'Poppins', sans-serif;
    }

    h2 {
        color: #3b2e20;
        font-weight: 700;
        font-size: 2.2rem;
        margin-bottom: 2rem;
    }

    .card {
        border-radius: 20px;
        overflow: hidden;
        border: none;
        transition: transform 0.4s ease, box-shadow 0.4s ease;
        background-color: #fff;
        height: 100%;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        display: flex;
        flex-direction: column;
    }

        .card:hover {
            transform: translateY(-10px) scale(1.03);
            box-shadow: 0 18px 40px rgba(0, 0, 0, 0.2);
        }

    .card-img-top {
        height: 300px;
        object-fit: cover;
        background-color: #f0ebe7;
    }

    .card-body {
        padding: 20px;
        flex-grow: 1;
        text-align: center;
    }

    .card-title {
        font-size: 1.3rem;
        font-weight: 600;
        color: #2f2418;
        margin: 0;
    }

    .btn-custom {
        background-color: #6f4e37;
        color: white;
        border: none;
        padding: 8px 20px;
        font-size: 0.95rem;
        border-radius: 25px;
        transition: all 0.3s ease;
    }

        .btn-custom:hover {
            background-color: #4e3525;
        }

    .input-group .form-select,
    .input-group .btn {
        border-radius: 25px !important;
    }

    .input-group .form-select {
        border: 1px solid #d1c7be;
    }

    .input-group .btn-custom {
        margin-left: 10px;
    }

    .modal-backdrop-custom {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.8);
        z-index: 1050;
        display: none;
        justify-content: center;
        align-items: center;
    }

    .modal-content-custom {
        background: #fffdf8;
        padding: 30px;
        border-radius: 20px;
        max-width: 650px;
        width: 95%;
        position: relative;
        box-shadow: 0 0 30px rgba(0,0,0,0.25);
    }

    #adVideo, #pdfFrame {
        width: 100%;
        border-radius: 15px;
    }

    #pdfFrame {
        height: 500px;
        border: none;
    }

    .btn-close-custom {
        position: absolute;
        top: 15px;
        right: 20px;
        font-size: 1.8rem;
        color: #333;
        background: transparent;
        border: none;
        cursor: pointer;
    }
</style>

<div class="container py-5">
    <h2 class="text-center">📚 Kitab Qalereyası</h2>

    <div class="row mb-4">
        <div class="col-md-6 offset-md-3">
            <form method="get" asp-action="Search" asp-controller="Book">
                <div class="input-group shadow-sm">
                    <select name="searchTerm" class="form-select">
                        @if (ViewBag.Categories != null)
                        {
                            foreach (var category in ViewBag.Categories as List<string>)
                            {
                                <option value="@category">@category</option>
                            }
                        }
                        else
                        {
                            <option disabled>Kateqoriyalar tapılmadı</option>
                        }
                    </select>

                    <button type="submit" class="btn btn-custom">
                        <i class="bi bi-search"></i> Axtar
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
        @foreach (var book in Model)
        {
            <div class="col d-flex">
                <a asp-action="Details" asp-controller="Book" asp-route-id="@book.Id" class="card text-decoration-none">
                    @if (!string.IsNullOrEmpty(book.Img))
                    {
                        <img src="@Url.Content("~/Imagess/" + book.Img)" class="card-img-top" alt="@book.Title" />
                    }
                    else
                    {
                        <div class="bg-light d-flex justify-content-center align-items-center" style="height: 300px;">
                            <span class="text-muted">Şəkil yoxdur</span>
                        </div>
                    }

                    <div class="card-body">
                        <h5 class="card-title">@book.Title</h5>
                    </div>
                </a>
            </div>
        }
    </div>
</div>

<!-- Reklam Modal -->
<div id="adModal" class="modal-backdrop-custom">
    <div class="modal-content-custom">
        <button class="btn-close-custom" onclick="closeAd()">×</button>
        <video id="adVideo" controls muted>
            <source src="@Url.Content("~/videos/sample-ad.mp4")" type="video/mp4" />
            Sizin brauzer video et dəstəkləmir.
        </video>
    </div>
</div>

<!-- PDF Modal -->
<div id="pdfModal" class="modal-backdrop-custom">
    <div class="modal-content-custom">
        <button class="btn-close-custom" onclick="closePdf()">×</button>
        <iframe id="pdfFrame"></iframe>
        <a id="downloadPdfBtn" class="btn btn-custom mt-3" download target="_blank">Yüklə</a>
    </div>
</div>

<script>
    function showAdThenPdf(pdfUrl) {
        const adModal = document.getElementById("adModal");
        const video = document.getElementById("adVideo");

        adModal.style.display = "flex";
        video.currentTime = 0;
        video.play();

        video.onended = function () {
            adModal.style.display = "none";
            showPdf(pdfUrl);
        };
    }

    function closeAd() {
        const adModal = document.getElementById("adModal");
        const video = document.getElementById("adVideo");

        video.pause();
        adModal.style.display = "none";
    }

    function showPdf(pdfUrl) {
        const pdfModal = document.getElementById("pdfModal");
        const pdfFrame = document.getElementById("pdfFrame");
        const downloadBtn = document.getElementById("downloadPdfBtn");

        pdfFrame.src = pdfUrl;
        downloadBtn.href = pdfUrl;
        pdfModal.style.display = "flex";
    }

    function closePdf() {
        const pdfModal = document.getElementById("pdfModal");
        const pdfFrame = document.getElementById("pdfFrame");

        pdfModal.style.display = "none";
        pdfFrame.src = "";
    }
</script>
