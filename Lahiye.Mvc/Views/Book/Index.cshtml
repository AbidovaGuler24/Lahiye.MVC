@model List<OnlineLearning.Core.ViewModels.BookVm>

@{
    ViewData["Title"] = "Books Grid View";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-4">
    <h2 class="mb-4">📚 Book Gallery</h2>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var book in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    @if (!string.IsNullOrEmpty(book.Img))
                    {
                        <img src="~/Imagess/@book.Img" class="card-img-top" alt="@book.Title" style="height: 200px;  width :200px" height="250" object-fit: cover;" />
                    }
                    else
                    {
                        <div class="bg-light d-flex justify-content-center align-items-center" style="height: 250px;">
                            <span class="text-muted">No Image</span>
                        </div>
                    }

                    <div class="card-body">
                        <h5 class="card-title">@book.Title</h5>
                        <p class="card-text text-truncate">@book.Description</p>
                        <p><strong>Page:</strong> @book.PageCount</p>
                    </div>

                    <div class="card-footer d-flex justify-content-between align-items-center">
                        <div>
                            @if (!string.IsNullOrEmpty(book.Pdf))
                            {
                                <button class="btn btn-sm btn-outline-primary" onclick="showAdThenDownload('/Files/@book.Pdf')">
                                    <i class="bi bi-file-earmark-pdf"></i> Download
                                </button>
                            }
                            else
                            {
                                <span class="text-muted">No PDF</span>
                            }
                        </div>
                        <a asp-action="Details" asp-route-id="@book.Id" class="btn btn-sm btn-info">
                            Details
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Reklam Modalı -->
<div id="adModal" style="display: none; position: fixed; top: 0; left: 0;
     width: 100%; height: 100%; background-color: rgba(0,0,0,0.7);
     z-index: 9999; justify-content: center; align-items: center; display: none;">

    <div style="background-color: white; padding: 20px; border-radius: 10px; max-width: 450px; width: 100%;">
        <h5 class="text-center">Reklam</h5>
        <video id="adVideo" width="100%" height="250" controls>
            <source src="~/ads/WhatsApp Video 2025-06-17 at 15.23.50 (1).mp4" type="video/mp4" />
            Sənin brauzerin videonu dəstəkləmir.
        </video>
    </div>
</div>

@section Scripts {
    <script>
        function showAdThenDownload(pdfUrl) {
            const adModal = document.getElementById('adModal');
            const adVideo = document.getElementById('adVideo');

            adModal.style.display = 'flex';
            adVideo.currentTime = 0;
            adVideo.play();

            adVideo.onended = function () {
                adModal.style.display = 'none';
                window.location.href = pdfUrl;
            };
        }
    </script>
}

