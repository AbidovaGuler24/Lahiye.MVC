@model OnlineLearning.Core.ViewModels.NewsEventVm
@{
    Layout = null;
}

@{
    ViewData["Title"] = "News/Event Details";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    body {
        background-color: #f9f7f1;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #4a3c31;
    }

    .details-container {
        max-width: 720px;
        margin: 50px auto;
        background: #fff9f0;
        padding: 30px 40px;
        border-radius: 16px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        border: 1px solid #e6d7c1;
    }

    h2 {
        font-weight: 700;
        color: #6b4f3d;
        margin-bottom: 20px;
        text-align: center;
        font-size: 2.5rem;
        letter-spacing: 1px;
    }

    .news-title {
        font-size: 1.8rem;
        font-weight: 600;
        margin-bottom: 15px;
        border-bottom: 2px solid #cba969;
        padding-bottom: 10px;
    }

    .news-date {
        font-size: 0.95rem;
        color: #a7886b;
        margin-bottom: 25px;
        font-style: italic;
    }

    .news-description {
        font-size: 1.1rem;
        line-height: 1.7;
        margin-bottom: 30px;
        color: #5a4d3a;
        white-space: pre-wrap;
    }

    .news-image {
        display: block;
        max-width: 100%;
        max-height: 420px;
        margin: 0 auto 30px;
        border-radius: 14px;
        box-shadow: 0 8px 18px rgba(107, 79, 61, 0.3);
        object-fit: cover;
    }

    .btn-group {
        display: flex;
        justify-content: center;
        gap: 15px;
    }

    .btn-primary, .btn-secondary {
        border-radius: 50px;
        padding: 10px 28px;
        font-weight: 600;
        font-size: 1rem;
        transition: background-color 0.3s ease;
    }

    .btn-primary {
        background-color: #8c6847;
        border: none;
        color: #fff;
    }

        .btn-primary:hover {
            background-color: #6b4f3d;
        }

    .btn-secondary {
        background-color: #d4c1a4;
        border: none;
        color: #4a3c31;
    }

        .btn-secondary:hover {
            background-color: #bba87e;
            color: #fff;
        }
</style>

<div class="details-container">
    <h2>@ViewData["Title"]</h2>

    <h3 class="news-title">@Model.Title</h3>

    <p class="news-date"><strong>Date:</strong> @Model.Date.ToString("dd MMMM yyyy")</p>

    <p class="news-description">@Model.Description</p>

    @if (!string.IsNullOrEmpty(Model.ImagePath))
    {
        <img src="~/imagess/@Model.ImagePath" alt="@Model.Title" class="news-image" />
    }
    else
    {
        <p class="text-center text-muted fst-italic">No image available.</p>
    }

    <div class="btn-group">

        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>
