@{
    ViewData["Title"] = "Ödəniş Təsdiqi";
    Layout = "_Layout1";
}

<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
        :root {
            --neon-blue: #00f2ff;
            --dark-space: #0a0e17;
            --electric-purple: #b721ff;
            --cyber-green: #00ff9d;
        }

        body {
            background-color: var(--dark-space);
            font-family: 'Orbitron', 'Segoe UI', sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            overflow: hidden;
            color: white;
        }

        .cyber-card {
            width: 90%;
            max-width: 600px;
            background: rgba(10, 14, 23, 0.8);
            border-radius: 16px;
            border: 1px solid var(--neon-blue);
            box-shadow: 0 0 20px rgba(0, 242, 255, 0.3), inset 0 0 20px rgba(0, 242, 255, 0.1);
            padding: 40px;
            position: relative;
            overflow: hidden;
            backdrop-filter: blur(10px);
            animation: glow-pulse 4s infinite alternate;
        }

            .cyber-card::before {
                content: '';
                position: absolute;
                top: -2px;
                left: -2px;
                right: -2px;
                bottom: -2px;
                background: linear-gradient(45deg, var(--neon-blue), var(--electric-purple), var(--cyber-green));
                z-index: -1;
                border-radius: 18px;
                animation: border-rotate 8s linear infinite;
                opacity: 0.7;
            }

        .cyber-icon {
            font-size: 5rem;
            margin-bottom: 20px;
            background: linear-gradient(to right, var(--neon-blue), var(--cyber-green));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            filter: drop-shadow(0 0 10px rgba(0, 242, 255, 0.7));
        }

        h2 {
            font-weight: 700;
            margin-bottom: 20px;
            font-size: 2.2rem;
            background: linear-gradient(to right, var(--neon-blue), var(--electric-purple));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        p {
            font-size: 1.2rem;
            margin-bottom: 30px;
            line-height: 1.6;
            color: rgba(255, 255, 255, 0.9);
        }

        .cyber-btn {
            background: transparent;
            border: 2px solid var(--neon-blue);
            color: white;
            padding: 12px 30px;
            font-size: 1.1rem;
            border-radius: 0;
            position: relative;
            overflow: hidden;
            transition: all 0.3s;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

            .cyber-btn::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(0, 242, 255, 0.4), transparent);
                transition: 0.5s;
            }

            .cyber-btn:hover {
                box-shadow: 0 0 15px var(--neon-blue), inset 0 0 10px rgba(0, 242, 255, 0.2);
                transform: translateY(-3px);
            }

                .cyber-btn:hover::before {
                    left: 100%;
                }

            .cyber-btn i {
                margin-right: 10px;
                font-size: 1.3rem;
            }

        .particles {
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            z-index: -1;
        }

        .particle {
            position: absolute;
            background: var(--neon-blue);
            border-radius: 50%;
            opacity: 0.5;
            animation: float infinite linear;
        }

        @@keyframes glow-pulse {
            0%

        {
            box-shadow: 0 0 20px rgba(0, 242, 255, 0.3);
        }

        100% {
            box-shadow: 0 0 40px rgba(183, 33, 255, 0.4);
        }

        }

        @@keyframes border-rotate {
            0%

        {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }

        }

        @@keyframes float {
            0%

        {
            transform: translateY(0) translateX(0);
            opacity: 0;
        }

        50% {
            opacity: 0.7;
        }

        100% {
            transform: translateY(-100vh) translateX(100px);
            opacity: 0;
        }

        }

        @@media (max-width: 768px) {
            .cyber-card

        {
            padding: 30px 20px;
            width: 95%;
        }

        h2 {
            font-size: 1.8rem;
        }

        }
    </style>
</head>
<body>
    <div class="particles" id="particles"></div>

    <div class="cyber-card text-center">
        <div class="cyber-icon">
            <i class="bi bi-check2-all"></i>
        </div>

        <h2>ÖDƏNİŞ TƏSDİQLƏNDİ</h2>
        <p>Kitabınız uğurla alındı! Digital kitabxananıza əlavə olundu. İndi istənilən vaxt, istənilən yerdən oxuya bilərsiniz.</p>

        <a href="/PaidBook/Index" class="cyber-btn">
            <i class="bi bi-collection"></i> KİTABXANAYA KEÇİD
        </a>
    </div>

    <script>
        // Particle effect
        document.addEventListener('DOMContentLoaded', function() {
            const particlesContainer = document.getElementById('particles');
            const particleCount = 30;

            for (let i = 0; i < particleCount; i++) {
                const particle = document.createElement('div');
                particle.classList.add('particle');

                // Random properties
                const size = Math.random() * 5 + 2;
                const posX = Math.random() * 100;
                const posY = Math.random() * 100 + 100;
                const duration = Math.random() * 15 + 10;
                const delay = Math.random() * 10;
                const color = i % 3 === 0 ? 'var(--neon-blue)' :
                              i % 3 === 1 ? 'var(--electric-purple)' : 'var(--cyber-green)';

                particle.style.width = `${size}px`;
                particle.style.height = `${size}px`;
                particle.style.left = `${posX}%`;
                particle.style.top = `${posY}%`;
                particle.style.animationDuration = `${duration}s`;
                particle.style.animationDelay = `${delay}s`;
                particle.style.backgroundColor = color;

                particlesContainer.appendChild(particle);
            }
        });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>