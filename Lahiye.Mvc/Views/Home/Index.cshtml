@model List<OnlineLearning.Core.ViewModels.PaidBookVm>

@{
    ViewData["Title"] = "Kitablar";
}

<h2>Kitablar</h2>

@if (Model != null && Model.Any())
{
    <div class="row">
        @foreach (var book in Model)
        {
            <div class="col-md-3 d-flex justify-content-center mb-4">
                <div class="book-card">

                    <form asp-action="AddToFavorites" asp-controller="Favorites" method="post">
                        <input type="hidden" name="id" value="@book.Id" />
                        <button type="submit" class="favorite-icon" title="Sevimli">❤️</button>
                    </form>

                    @if (!string.IsNullOrEmpty(book.Img))
                    {
                        <a asp-controller="PaidBook" asp-action="Details" asp-route-id="@book.Id" title="@book.Title">
                            <img src="~/Imagess/@book.Img" class="book-image" alt="@book.Title" />
                        </a>
                    }
                    else
                    {
                        <div class="no-image">Şəkil yoxdur</div>
                    }

                    <div class="book-body">
                        <div class="book-meta">Qiymət: @book.Price ₼</div>
                    </div>


                </div>
            </div>
        }
    </div>

   @*  <div class="text-center mt-4">
        <button id="loadMoreBtn" class="btn btn-primary">Daha çox göstər</button>
    </div> *@
}
else
{
    <p>Kitab tapılmadı.</p>
}

<style>
    body {
        background-color: #f8f9fa;
        font-family: 'Arial', sans-serif;
    }

    h2 {
        color: #333;
        margin: 30px 0;
        font-weight: bold;
        text-align: center;
    }

    .book-card {
        width: 100%;
        background: white;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        overflow: hidden;
        position: relative;
        transition: transform 0.3s;
    }

        .book-card:hover {
            transform: translateY(-5px);
        }

    .book-wrapper {
        width: 12.5%; /* 100/8=12.5% */
        padding: 0 8px;
        margin-bottom: 20px;
    }

    .favorite-icon {
        position: absolute;
        top: 10px;
        right: 10px;
        background: none;
        border: none;
        font-size: 20px;
        color: #ff4757;
        cursor: pointer;
        z-index: 10;
    }

    .book-image {
        width: 100%;
        height: 400px;
        object-fit: cover;
        border-bottom: 1px solid #eee;
    }

    .no-image {
        width: 100%;
        height: 400px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eee;
        color: #666;
        border-bottom: 1px solid #ddd;
    }

    .book-body {
        padding: 10px;
    }

    .book-title {
        font-weight: bold;
        font-size: 14px;
        color: #333;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-bottom: 5px;
    }

    .book-meta {
        font-size: 12px;
        color: #e67e22;
        font-weight: bold;
    }

    @@media (max-width: 1200px) {
        .book-wrapper

    {
        width: 16.66%;
    }
    /* 6 kitab */
    }

    @@media (max-width: 992px) {
        .book-wrapper

    {
        width: 20%;
    }
    /* 5 kitab */
    }

    @@media (max-width: 768px) {
        .book-wrapper

    {
        width: 25%;
    }
    /* 4 kitab */
    }

    @@media (max-width: 576px) {
        .book-wrapper

    {
        width: 50%;
    }
    /* 2 kitab */
    }
</style>


