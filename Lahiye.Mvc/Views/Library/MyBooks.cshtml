@model List<OnlineLearning.Core.Entities.PurchasedBook>

@{
    Layout = null;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<h2 class="mb-4">Sizin Kitablarınız</h2>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">Heç bir kitab almamısınız.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th>Kitab</th>
                <th>Alınma Tarixi</th>
                <th>PDF</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <div class="d-flex align-items-center">
                            @* <img src="~/Imagess/@book.Img" class="book-image" alt="@book.Title" /> *@
                            <img  src="~/Imagess/@item.Book.Img" alt="@item.Book.Title" style="width: 60px; height: 80px; object-fit: cover; margin-right: 15px; border-radius: 4px;" />
                            <span>@item.Book.Title</span>
                        </div>
                    </td>
                    <td>@item.PurchaseDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                    <td>
                        <a href="@Url.Action("ReadBook", "PaidBook", new { id = item.Book.Id })" class="btn btn-sm btn-success" target="_blank">
                            <i class="bi bi-book"></i> Oxu
                        </a>
                    </td>

                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.js"></script>
