@model List<OnlineLearning.Core.Entities.PurchasedBook>
@using OnlineLearning.Core.Helpers.Exictance
@{
    Layout = "_Layout1";
}

<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sizin Kitablarınız</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
        :root {
            --primary-color: #D2B48C;
            --secondary-color: #F5F5DC;
            --accent-color: #CDAA7D;
            --text-color: #5A534A;
            --light-beige: #FAF8F4;
            --dark-beige: #E6DAC8;
        }

        body {
            background-color: var(--light-beige);
            color: var(--text-color);
            font-family: 'Georgia', serif;
            line-height: 1.6;
        }

        .container-wrapper {
            max-width: 1200px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .page-header {
            border-bottom: 1px solid var(--dark-beige);
            padding-bottom: 20px;
            margin-bottom: 40px;
        }

        .page-title {
            color: var(--text-color);
            font-weight: 600;
            letter-spacing: 0.5px;
            position: relative;
            padding-bottom: 10px;
        }

            .page-title:after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 0;
                width: 60px;
                height: 3px;
                background: var(--primary-color);
            }

        .book-card {
            transition: all 0.4s ease;
            border-radius: 12px;
            overflow: hidden;
            border: none;
            background-color: white;
            box-shadow: 0 4px 20px rgba(210, 180, 140, 0.1);
            height: 100%;
            position: relative;
        }

            .book-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 8px 25px rgba(210, 180, 140, 0.2);
            }

        .book-image {
            width: 80px;
            height: 120px;
            object-fit: cover;
            border-radius: 6px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s;
        }

        .book-card:hover .book-image {
            transform: scale(1.05);
        }

        .btn-read {
            background-color: var(--primary-color);
            border: none;
            padding: 8px 20px;
            border-radius: 6px;
            transition: all 0.3s;
            font-weight: 500;
            letter-spacing: 0.5px;
        }

            .btn-read:hover {
                background-color: var(--accent-color);
                transform: translateY(-2px);
                box-shadow: 0 4px 8px rgba(210, 180, 140, 0.3);
            }

        .empty-state {
            background-color: white;
            padding: 50px;
            border-radius: 12px;
            text-align: center;
            box-shadow: 0 4px 20px rgba(210, 180, 140, 0.1);
            border: 1px dashed var(--dark-beige);
        }

        .empty-state-icon {
            font-size: 5rem;
            color: var(--dark-beige);
            margin-bottom: 25px;
        }

        .purchase-date {
            color: #8C7B6D;
            font-size: 0.9rem;
            font-style: italic;
        }

        .book-title {
            font-weight: 600;
            color: var(--text-color);
            margin-bottom: 5px;
        }

        .book-author {
            color: #8C7B6D;
            font-size: 0.9rem;
            margin-bottom: 10px;
        }

        .card-content {
            padding: 25px;
        }

        .book-badge {
            position: absolute;
            top: 15px;
            right: 15px;
            background-color: var(--primary-color);
            color: white;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        @@media (max-width: 768px) {
            .book-image

        {
            width: 70px;
            height: 100px;
        }

        .card-content {
            padding: 20px;
        }

        .empty-state {
            padding: 30px;
        }

        }
    </style>
</head>
<body>
    <div class="container-wrapper">
        <div class="page-header">
            <h1 class="page-title"><i class="bi bi-book-half me-2"></i>Sizin Kitab Kolleksiyanız</h1>
            <p class="text-muted mt-2">Özəl kitabxananızda topladığınız əziz kitablar</p>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="empty-state">
                <i class="bi bi-book empty-state-icon"></i>
                <h3 class="mb-3">Kitabxananız hazırda boşdur</h3>
                <p class="text-muted mb-4">Hələ heç bir kitab əldə etməmisiniz. Eksklüziv kolleksiyamıza nəzər yetirin və özünüzə xoş gələcək kitablar seçin.</p>
                <a href="#" class="btn px-4" style="background-color: var(--primary-color); color: white;">
                    <i class="bi bi-shop me-2"></i>Kitab Mağazasını Kəşf Edin
                </a>
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var item in Model)
                {
                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="book-card">
                            <div class="card-content">
                                <span class="book-badge">Yeni</span>
                                <div class="d-flex align-items-start">
                                    <img src="~/Imagess/@item.Book.Img" alt="@item.Book.Title" class="book-image me-3" />
                                    <div>
                                        <h5 class="book-title">@item.Book.Title</h5>

                                       @*  @{
                                            DateTime sqlDate = item.PurchaseDate;
                                            DateTime utcDate = DateTime.SpecifyKind(sqlDate, DateTimeKind.Utc);
                                            TimeZoneInfo azerbaijanTimeZone = TimeZoneInfo.FindSystemTimeZoneById("Azerbaijan Standard Time");
                                            DateTime azDate = TimeZoneInfo.ConvertTimeFromUtc(utcDate, azerbaijanTimeZone);
                                        }

                                        <p class="purchase-date mb-3">
                                            <i class="bi bi-calendar-check me-1"></i>
                                            @azDate.ToString("dd.MM.yyyy HH:mm")
                                        </p> *@

                                       @* 
                                        <p class="purchase-date mb-3">
                                            <i class="bi bi-calendar-check me-1"></i>
                                            @item.PurchaseDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                        </p> *@
                                        <a href="@Url.Action("ReadBook", "PaidBook", new { id = item.Book.Id })"
                                           class="btn btn-read text-white" target="_blank">
                                            <i class="bi bi-book me-1"></i> Oxumağa Başla
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>