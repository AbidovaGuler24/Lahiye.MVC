

 @model List<OnlineLearning.Core.ViewModels.CafeMenuItemVM>

@{
    ViewData["Title"] = "Cafe Menu";
}


<body>
    <h2 class="text-center mt-5 mb-4 display-5 fw-bold">Cafe Menu</h2>

    <div class="container">
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 rounded-4">
                        <img src="~/Imagess/@item.ImagePath" class="card-img-top rounded-top-4" alt="@item.Name"
                             style="height: 240px; object-fit: cover;" />
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title text-center text-dark fw-semibold fs-4">@item.Name</h5>
                            <p class="card-text text-center mb-2">
                                <span class="text-muted">Qiymət:</span> <span class="fw-bold">@item.Price.ToString("0.00") ₼</span>
                            </p>
                            <a href="@Url.Action("Details", "CafeMenu", new { id = item.Id })"
                               class="btn btn-outline-success w-100 mt-auto rounded-pill">Ətraflı Bax</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</body>

